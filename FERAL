local function namedQuestReady(quest, hydration)
    if not CONFIG.AutoQuest or not CONFIG.AutoDrink then return false end
    if not quest or quest.done or hydration == nil then return false end
    if not namedDrinkWaypoint(quest) then return false end
    return hydration <= CONFIG.QuestNamedDrinkStart
        and os.clock() >= (namedDrinkRetryAt[quest.title] or 0)
end

local function doNamedDrinkQuest(quest)
    local waypoint, place = namedDrinkWaypoint(quest)
    if not waypoint or not active or not CONFIG.AutoQuest or not CONFIG.AutoDrink then return false end
    local actionEpoch = controlsEpoch
    local char, hum, root = actor()
    if not char then return false end

    -- Evita repeticao se nao conseguir interagir ou se outra aba nao mostra DONE.
    namedDrinkRetryAt[quest.title] = os.clock() + CONFIG.QuestNamedDrinkCooldown
    local initialDistance = horizontal(root.Position, waypoint).Magnitude
    print("AUTO QUEST AGUA:", quest.title,
        "| indo para", place, "| faltam", math.floor(initialDistance), "studs")

    local getDistance = startMovement(hum, root,
        function() return waypoint end,
        function() return 5 end,
        function(d)
            if d > 45 then return CONFIG.WaterCruiseSpeed end
            if d > 15 then return CONFIG.WaterMoveSpeed end
            return 7
        end, true)
    local started = os.clock()
    local lastProgress = started
    local shortestDistance = initialDistance
    local lastLog = 0
    local arrived = initialDistance <= 5
    local timeout = math.min(CONFIG.QuestNamedDrinkTimeout, math.max(30, initialDistance / 9 + 20))

    while active and CONFIG.AutoQuest and CONFIG.AutoDrink and controlsEpoch == actionEpoch
        and char == player.Character and root.Parent and os.clock() - started < timeout do
        task.wait(0.25)
        local state = questSeen[quest.title]
        if state and state.done then
            stopMovement()
            print("AUTO QUEST AGUA: concluida antes de chegar!", place)
            return true
        end
        local thirst = getThirst()
        if thirst and thirst < CONFIG.QuestNamedDrinkSafetyThreshold then
            print("AUTO QUEST AGUA: sede muito baixa; priorizando fonte proxima")
            break
        end
        local dist, reached = getDistance()
        if reached or dist <= 5 then arrived = true; break end
        if dist < shortestDistance - 0.6 then
            shortestDistance = dist
            lastProgress = os.clock()
        end
        if os.clock() - lastProgress >= CONFIG.StuckTimeout then
            warn("AUTO QUEST AGUA: obstaculo no caminho de", place)
            break
        end
        if os.clock() - lastLog > 7 then
            print("AUTO QUEST AGUA:", place, "| faltam", math.floor(dist), "studs")
            lastLog = os.clock()
        end
    end
    stopMovement()
    if not active or not CONFIG.AutoQuest or not CONFIG.AutoDrink or controlsEpoch ~= actionEpoch then return false end
    if not arrived then
        warn("AUTO QUEST AGUA: nao alcancou", place, "| tentara novamente depois")
        return false
    end

    print("AUTO QUEST AGUA: chegou em", place, "| tentando Feed drink")
    local before = getThirst()
    local lastThirst = before or 0
    local lastGain = os.clock()
    local lastPress = 0
    local confirmedGain = false
    local attempts = 0
    local deadline = os.clock() + 35

    while active and CONFIG.AutoQuest and CONFIG.AutoDrink and controlsEpoch == actionEpoch
        and root.Parent and char == player.Character and os.clock() < deadline do
        local q = questSeen[quest.title]
        if q and q.done then
            print("AUTO QUEST AGUA: MISSAO CONCLUIDA:", quest.title)
            return true
        end
        local current = getThirst()
        if not current then break end
        if current > lastThirst + 0.1 then
            confirmedGain = true
            lastGain = os.clock()
        end
        lastThirst = current
        if current >= CONFIG.DrinkStop and confirmedGain then
            break
        end
        local state = promptState()
        if windowFocused and (state == "EAT" or state == "EATING") then
            print("AUTO QUEST AGUA: prompt EAT; evitando acionar comida")
            break
        end
        if attempts == 0 or (os.clock() - lastGain > 4 and os.clock() - lastPress > 4) then
            if attempts >= 5 then break end
            attempts += 1
            lastPress = os.clock()
            local ok,method=feedInteraction("drink")
            if ok then
                print("AUTO QUEST AGUA:", place,"| Feed drink via",method,"| tentativa",attempts)
            else
                warn("AUTO QUEST AGUA: falha ao enviar Feed drink")
                break
            end
        end
        -- A GUI pode atualizar com pequeno atraso apos beber.
        task.wait(0.85)
    end
    if not CONFIG.AutoQuest or not CONFIG.AutoDrink or controlsEpoch ~= actionEpoch then return false end
    if questSeen[quest.title] and questSeen[quest.title].done then
        print("AUTO QUEST AGUA: MISSAO CONCLUIDA:", quest.title)
        return true
    end
    if confirmedGain then
        print("AUTO QUEST AGUA: hidratacao subiu em", place,
            "| aguardando confirmacao da quest na aba QUICK/DAILY")
    else
        warn("AUTO QUEST AGUA: Feed drink nao confirmou hidratacao em", place)
    end
    return false
end

