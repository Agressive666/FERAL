local function respawnVisible(obj)
    if not obj or not obj.Parent then return false end
    local at=obj
    while at and at~=player do
        if at:IsA("ScreenGui") and not at.Enabled then return false end
        if at:IsA("GuiObject") and (not at.Visible or at.AbsoluteSize.X<2 or at.AbsoluteSize.Y<2) then
            return false
        end
        at=at.Parent
    end
    return true
end

local function normalizeRespawnText(value)
    return tostring(value or ""):gsub("<[^>]*>", "")
        :gsub("&nbsp;", " "):gsub("%s+", " ")
        :gsub("^%s+", ""):gsub("%s+$", ""):upper()
end

-- === V8.9.37: DETECTOR DE RESPAWN ===
-- O texto pode estar num TextLabel dentro/sobre um ImageButton, ou o
-- proprio botao pode usar nome Respawn e nenhum TextButton.Text.
-- NUNCA seleciona REVIVE, CHANGE ANIMAL, BUY ou opcoes com Robux.
local function locateRespawnUI()
    local pg=player:FindFirstChild("PlayerGui")
    if not pg then return nil,false,"SEM PLAYERGUI" end
    local objects=pg:GetDescendants()
    local deathTitle=false
    local hints={}
    local best,bestScore=nil,0
    local fallbackLabel=nil
    local function isOwnPanel(obj)
        local ui=obj:FindFirstAncestorWhichIsA("ScreenGui")
        local sn=ui and ui.Name:upper() or ""
        return sn:find("THEGOAT",1,true) or sn:find("THE_GOAT",1,true)
            or sn:find("TGFERAL",1,true)
    end
    local function forbidden(value)
        local t=normalizeRespawnText(value)
        return t:find("REVIVE",1,true) or t:find("ROBUX",1,true)
            or t:find("CHANGE ANIMAL",1,true)
            or t:find("PURCHASE",1,true) or t:find("BUY NOW",1,true)
            or t:find("AUTO RESPAWN",1,true)
    end
    for _,obj in ipairs(objects) do
        if not isOwnPanel(obj) and respawnVisible(obj) then
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                local t=normalizeRespawnText(obj.Text)
                if t:find("YOU DIED",1,true) or t:find("YOU ARE DEAD",1,true)
                    or t:find("YOU'VE DIED",1,true) or t=="DEATH" then
                    deathTitle=true
                end
                if t:find("RESPAWN",1,true) and not forbidden(t) then
                    if #hints<8 then hints[#hints+1]=obj.Name.."="..t:sub(1,65) end
                    if obj:IsA("TextLabel") then
                        fallbackLabel=fallbackLabel or obj
                    end
                end
            end
        end
    end
    -- Procurar botoes reais, sem presumir que seu Text seja "RESPAWN".
    for _,obj in ipairs(objects) do
        if obj:IsA("GuiButton") and respawnVisible(obj) and not isOwnPanel(obj) then
            local ui=obj:FindFirstAncestorWhichIsA("ScreenGui")
            local screenName=normalizeRespawnText(ui and ui.Name or "")
            local ownName=normalizeRespawnText(obj.Name)
            local ownText=obj:IsA("TextButton") and normalizeRespawnText(obj.Text) or ""
            local parent=obj.Parent
            local parentName=normalizeRespawnText(parent and parent.Name or "")
            local childText=""
            for _,child in ipairs(obj:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    if respawnVisible(child) then
                        childText=childText.." "..normalizeRespawnText(child.Text)
                    end
                end
            end
            local parts=ownName.." "..ownText.." "..childText
            local score=0
            if ownText:find("RESPAWN",1,true) then score=score+110 end
            if ownName:find("RESPAWN",1,true) then score=score+95 end
            if childText:find("RESPAWN",1,true) then score=score+90 end
            if parentName:find("RESPAWN",1,true) then score=score+65 end
            if parent then
                -- Rótulo pode ser IRMAO do ImageButton (mesmo quadro),
                -- como nas interfaces estilizadas do FERAL.
                for _,sib in ipairs(parent:GetChildren()) do
                    if sib~=obj and (sib:IsA("TextLabel") or sib:IsA("TextButton"))
                        and respawnVisible(sib) then
                        local txt=normalizeRespawnText(sib.Text)
                        if txt:find("RESPAWN",1,true) then
                            local mid=obj.AbsolutePosition+obj.AbsoluteSize/2
                            local midLabel=sib.AbsolutePosition+sib.AbsoluteSize/2
                            if (mid-midLabel).Magnitude<=math.max(110,obj.AbsoluteSize.X) then
                                score=score+45
                            end
                        end
                    end
                end
            end
            if screenName:find("DEATH",1,true) or screenName:find("DIED",1,true)
                or screenName:find("DEAD",1,true) then score=score+10 end
            if ownText:find("FREE",1,true) or childText:find("FREE",1,true)
                or ownName:find("FREE",1,true) then score=score+15 end
            -- Exigir uma pista concreta do respawn, nunca um botao generico.
            if forbidden(parts) or forbidden(parentName)
                or ownName:find("AUTO",1,true) or ownName:find("TOGGLE",1,true)
                or ownName:find("REVIVE",1,true) then score=-1 end
            if score>bestScore and score>=45 then
                bestScore,best=score,obj
            end
        end
    end
    -- Se a GUI usa Frame clicavel no lugar de GuiButton, mandar clique
    -- virtual sobre o rótulo exato de respawn, sem acionar remotes.
    if not best and fallbackLabel and respawnVisible(fallbackLabel)
        and not forbidden(fallbackLabel.Parent and fallbackLabel.Parent.Name or "") then
        best=fallbackLabel
        hints[#hints+1]="FALLBACK=rotulo (sem GuiButton reconhecido)"
    end
    local debugText="Candidatos: "..(#hints>0 and table.concat(hints," | ") or "nenhum")
    if best then debugText=debugText.." | SELECIONADO: "..best:GetFullName() end
    return best,deathTitle,debugText
end

-- Descobre a morte mesmo quando a GUI 'YOU DIED' ainda nao carregou.
local observedHumanoid, diedConnection = nil, nil
local function watchDeath(hum)
    -- Ao morrer, o jogo pode remover o Humanoid antes de abrir a tela de morte.
    -- Nao apagar o sinal de morte ate aparecer um NOVO Humanoid.
    if not hum or hum==observedHumanoid then return end
    if diedConnection then pcall(function() diedConnection:Disconnect() end) end
    observedHumanoid=hum
    respawnState.observedDied=(hum~=nil and hum.Health<=0) or false
    if hum then
        diedConnection=hum.Died:Connect(function()
            respawnState.observedDied=true
        end)
    end
end

