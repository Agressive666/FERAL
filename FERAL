-- Se a animacao custom nao expuser estado, exige confirmacao visual manual.
local restGuard = {
    blocked=false, character=nil, knownRestTracks={}, observedRest=false,
    unknownSince=0,
    attempts=0, lastTry=0, lastWarning=0, lastSource="nao verificado",
    phase="EM ESPERA", inputMethod="nenhum", lastInputOK=nil,
    lastProgress=0, failedStarts=0, lastInputError=nil
}

local function animationTrackIds(hum)
    local result={}
    local animator=hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return result end
    local ok,tracks=pcall(function() return animator:GetPlayingAnimationTracks() end)
    if not ok then return result end
    for _,track in ipairs(tracks) do
        local anim=track.Animation
        local id=anim and tostring(anim.AnimationId) or ""
        -- Nomes como "Animation" nao sao identificadores confiaveis.
        if id:match("%d+") then result[id]=true end
    end
    return result
end

local function clearRestGuard(reason)
    if restGuard.blocked then
        print("AUTO QUEST REST: LOBO EM PE | automacoes liberadas |",reason)
    end
    restGuard.blocked=false
    restGuard.character=nil
    restGuard.knownRestTracks={}
    restGuard.observedRest=false
    restGuard.unknownSince=0
    restGuard.attempts=0
    restGuard.lastTry=0
    restGuard.lastSource=reason or "em pe"
end

-- Verificacao conservadora: retorna nil quando o FERAL nao expoe estado confiavel.
-- Nunca usar apenas Humanoid.Sit=false para deduzir que um animal custom levantou.
local function detectResting(char, hum)
    local awakeEvidence,awakeSource=nil,nil
    local boolNames={"IsResting","Resting","IsSleeping","Sleeping","IsLying","Lying"}
    for _,inst in ipairs({char,player,hum}) do
        if inst then
            for _,name in ipairs(boolNames) do
                local value=inst:GetAttribute(name)
                if value==true then return true,inst.Name .. "." .. name end
                if value==false and awakeEvidence==nil then
                    awakeEvidence=false
                    awakeSource=inst.Name .. "." .. name
                end
            end
            for _,name in ipairs({"AnimalState","ActionState","CurrentAction","Pose","RestState"}) do
                local value=inst:GetAttribute(name)
                if type(value)=="string" then
                    local lower=value:lower()
                    if lower:find("rest",1,true) or lower:find("sleep",1,true)
                        or lower:find("lying",1,true) or lower:find("laydown",1,true) then
                        return true,inst.Name .. "." .. name .. "=" .. value
                    end
                    if lower=="idle" or lower=="idling" or lower=="standing"
                        or lower=="walk" or lower=="walking" or lower=="running" then
                        awakeEvidence=false
                        awakeSource=inst.Name .. "." .. name .. "=" .. value
                    end
                end
            end
        end
    end
    local animator=hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        local ok,tracks=pcall(function() return animator:GetPlayingAnimationTracks() end)
        if ok then
            for _,track in ipairs(tracks) do
                local anim=track.Animation
                local name=(anim and anim.Name or track.Name or ""):lower()
                if name:find("rest",1,true) or name:find("sleep",1,true)
                    or name:find("laydown",1,true) or name:find("lying",1,true) then
                    return true,"animacao: " .. name
                end
            end
        end
    end
    -- Uma animacao nova apos R NAO prova descanso: pode ser corrida, idle,
    -- ataque ou transicao. So confiamos em atributo/animacao com nome explicito.
    -- A antiga suposicao deixava o animal bloqueado mesmo estando em pe.
    if awakeEvidence==false then return false,awakeSource end
    return nil,"sem sinal confiavel"
end

local function restGateReady()
    if not restGuard.blocked then return true end
    local char,hum=actor()
    if not char or char~=restGuard.character then
        clearRestGuard("personagem substituido")
        return true
    end
    local resting,source=detectResting(char,hum)
    restGuard.lastSource=source
    if resting==false then
        clearRestGuard(source)
        return true
    end
    local now=os.clock()
    if resting==nil then
        if restGuard.unknownSince==0 then restGuard.unknownSince=now end
        if now-restGuard.unknownSince>=CONFIG.QuestRestUnknownUnlockSeconds then
            warn("AUTO QUEST REST: SEM SINAL DE DESCANSO; liberando trava indefinida " ..
                "e pausando novas tentativas da quest para evitar ataque deitado")
            clearRestGuard("estado desconhecido; confirme visualmente que esta em pe")
            return true
        end
    else
        restGuard.unknownSince=0
    end
    stopMovement()
    setActivity("AutoQuest","AGUARDANDO LEVANTAR")
    setActivity("AutoFood","BLOQUEADO: DESCANSO")
    setActivity("AutoGrass","BLOQUEADO: DESCANSO")
    setActivity("AutoDrink","BLOQUEADO: DESCANSO")
    setActivity("GetAmber",CONFIG.GetAmber and "BLOQUEADO: DESCANSO" or "DESATIVADO")
    -- So tenta R novamente se EXISTE evidencia de que continua deitado.
    -- Com estado desconhecido, novo R poderia fazer o lobo DEITAR de novo.
    if resting==true and restGuard.attempts<3 and now-restGuard.lastTry>=7 then
        restGuard.attempts += 1
        restGuard.lastTry=now
        local method=restGuard.attempts%2==1 and "vim" or "executor"
        warn("AUTO QUEST REST: ainda deitado; tentando levantar com R |",
            "tentativa",restGuard.attempts,"|",source)
        pressRestKey(method)
        task.wait(2)
        local after,afterSource=detectResting(char,hum)
        restGuard.lastSource=afterSource
        if after==false then
            clearRestGuard(afterSource)
            return true
        end
    end
    if now-restGuard.lastWarning>=18 then
        restGuard.lastWarning=now
        warn("AUTO QUEST REST: CAÇA/TRAVEL/FOOD/DRINK BLOQUEADOS; " ..
            "saida do descanso ainda nao confirmada | " .. tostring(restGuard.lastSource))
        warn("AUTO QUEST REST: se o lobo JA estiver em pe, use " ..
            "_G.TGFeralV8928.confirmStanding() apos conferir visualmente")
    end
    return false
end

