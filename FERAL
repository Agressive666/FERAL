-- Rest quest: no FERAL o usuario confirmou R como toggle de descanso.
local function pressRestKey(method, holdSeconds)
    -- VIM primeiro: alguns executores aceitam keypress() sem o FERAL processar o R.
    -- Sucesso do pcall NAO confirma que o jogo entrou no descanso.
    method=method or "vim"
    local hold=math.clamp(holdSeconds or 0.20,0.10,0.65)
    local ok,err=false,nil
    if method=="executor" then
        if type(keypress)~="function" or type(keyrelease)~="function" then
            return false,"executor indisponivel","executor"
        end
        ok,err=pcall(function()
            keyrelease(0x52) -- desarma tecla eventualmente presa
            task.wait(0.07)
            keypress(0x52)
            task.wait(hold)
            keyrelease(0x52)
        end)
        pcall(function() keyrelease(0x52) end)
    else
        ok,err=pcall(function()
            local vim=game:GetService("VirtualInputManager")
            vim:SendKeyEvent(false,Enum.KeyCode.R,false,game)
            task.wait(0.07)
            vim:SendKeyEvent(true,Enum.KeyCode.R,false,game)
            task.wait(hold)
            vim:SendKeyEvent(false,Enum.KeyCode.R,false,game)
        end)
    end
    if not ok then
        warn("AUTO QUEST REST: ERRO envio R via " .. method .. ":",tostring(err))
    end
    return ok,err,method
end

