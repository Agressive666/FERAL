end

-- AUTO GRASS: identificar a ESPECIE antes da dieta. Ex.: Hippo/Hippopotamus
-- pode nao ter Diet disponivel, ou um valor generico nao representar a dieta real.
-- A leitura cobre atributos do Character/Player, StringValues e submodelo animal.
-- Nao varre o workspace nem altera o personagem.
local herbivoreNames = {
    "hippopotamus", "hippo", "elephant", "rhino", "rhinoceros", "deer", "elk",
    "bison", "buffalo", "porcupine", "goat", "moose", "antelope", "gazelle",
    "giraffe", "zebra", "horse", "rabbit", "hare", "reindeer", "caribou",
    "wildebeest", "capybara", "tapir", "okapi", "camel", "llama", "alpaca",
    "sheep", "cow", "cattle", "donkey", "yak", "ibex", "manatee"
}
local carnivoreNames = {
    "wolf", "tiger", "otter", "fox", "bear", "cougar", "python", "cobra",
    "alligator", "crocodile", "eagle", "lion", "leopard", "hyena",
    "cheetah", "jaguar", "panther", "lynx", "shark"
}
local speciesKeys = {"Species", "SpeciesName", "AnimalSpecies", "CurrentSpecies",
    "Animal", "AnimalName", "AnimalType", "Creature", "CreatureType", "SelectedAnimal"}
local dietKeys = {"Diet", "AnimalDiet", "FoodType"}
local function herbivoreState()
    local char = player.Character
    if not char then return nil, "SEM PERSONAGEM" end
    local species, diets = {}, {}
    local function add(list, value)
        if type(value) == "string" and value ~= "" then
            table.insert(list, value)
        end
    end
    local function collect(container)
        if not container then return end
        for _, key in ipairs(speciesKeys) do
            add(species, container:GetAttribute(key))
        end
        for _, key in ipairs(dietKeys) do
            add(diets, container:GetAttribute(key))
        end
        -- Jogos podem usar StringValue em vez de Attribute para nome/dieta.
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("StringValue") then
                for _, key in ipairs(speciesKeys) do
                    if child.Name == key then add(species, child.Value); break end
                end
                for _, key in ipairs(dietKeys) do
                    if child.Name == key then add(diets, child.Value); break end
                end
            end
        end
    end
    collect(char)
    -- Alguns rigs usam submodelo com o nome real: Hippo_Male, Elephant etc.
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Model") then
            add(species, child.Name)
            for _, key in ipairs(speciesKeys) do
                add(species, child:GetAttribute(key))
            end
        end
    end
    collect(player)
    -- Classificar especie conhecida primeiro; nao confundir nome da conta com animal.
    -- Normalizacao suporta Hippo_Male, Hippopotamus-Female, nomes com espacos etc.
    for _, value in ipairs(species) do
        local normalized = value:lower():gsub("[^%a]", "")
        for _, name in ipairs(herbivoreNames) do
            if normalized:find(name, 1, true) then return true, value end
        end
        for _, name in ipairs(carnivoreNames) do
            if normalized:find(name, 1, true) then return false, value end
        end
    end
    for _, value in ipairs(diets) do
        local d = value:lower()
        if d:find("herbi", 1, true) or d:find("graze", 1, true)
            or d:find("grass", 1, true) or d:find("plant", 1, true)
            or d:find("veget", 1, true) then return true, value end
        if d:find("carni", 1, true) or d:find("meat", 1, true)
            or d:find("predator", 1, true) then return false, value end
    end
    -- Fallback final: apenas se o nome do Character identifica uma especie.
    -- Se continuar desconhecido, nao assume que todo animal e herbivoro.
    local normalized = char.Name:lower():gsub("[^%a]", "")
    for _, name in ipairs(herbivoreNames) do
        if normalized:find(name, 1, true) then return true, char.Name end
    end
    for _, name in ipairs(carnivoreNames) do
        if normalized:find(name, 1, true) then return false, char.Name end
    end
    return nil, "ESPECIE NAO IDENTIFICADA"
end

-- Auto selecao de alimentacao. A escolha do usuario nos botoes vale ate
-- o animal mudar (nova especie, novo character ou estado desconhecido->conhecido).
local dietSwitchState = {character=nil, mode=nil, species=nil, lastAt=0}
local function syncAutoDiet()
    local char = player.Character
    local herbivore, species = herbivoreState()
    local mode = herbivore==true and "HERBIVORO" or
        (herbivore==false and "CARNIVORO" or "DESCONHECIDO")
    if CONFIG.AutoDietSwitch and
        (char ~= dietSwitchState.character or mode ~= dietSwitchState.mode) then
        dietSwitchState.character=char
        dietSwitchState.mode=mode
        dietSwitchState.species=species
        dietSwitchState.lastAt=os.clock()
        CONFIG.AutoGrass=(herbivore==true)
        CONFIG.AutoFood=(herbivore==false)
        controlsEpoch += 1 -- encerra rotas da dieta anterior, se houver
        setActivity("AutoGrass",CONFIG.AutoGrass and "EM ESPERA" or "DESATIVADO")
        setActivity("AutoFood",CONFIG.AutoFood and "EM ESPERA" or "DESATIVADO")
        print("THE GOAT AUTO DIETA:",mode,"| animal:",tostring(species),
            "| Grass:",CONFIG.AutoGrass,"| Food:",CONFIG.AutoFood)
    end
    return herbivore, species
end

local function getThirst()
