                respawnState.successes+=1
                respawnState.lastStatus="RENASCIMENTO CONFIRMADO"
                setActivity("AutoRespawn","AGUARDANDO MORTE")
                safeLandPosition=nil
                safeLandCharacter=nil
                nextDrinkTry=0
                failedUntil=setmetatable({}, {__mode = "k"})
                questSeen={}
                questLastSignature=nil
                questDoneAnnounced={}
                questLastLogged={}
                clearRestGuard("novo personagem apos respawn")
                feeding=false
                drinking=false
                setActivity("AutoFood","EM ESPERA")
                setActivity("AutoGrass",CONFIG.AutoGrass and "EM ESPERA" or "DESATIVADO")
                setActivity("AutoDrink","EM ESPERA")
                setActivity("AutoQuest","EM ESPERA")
                setActivity("GetAmber",CONFIG.GetAmber and "EM ESPERA" or "DESATIVADO")
                print("THE GOAT: PERSONAGEM VIVO | automacoes liberadas apos respawn natural")
            else
                respawnState.lastStatus="AGUARDANDO PERSONAGEM"
                setActivity("AutoRespawn",respawnState.lastStatus)
            end
        else
            setActivity("AutoRespawn",CONFIG.AutoRespawn and "AGUARDANDO MORTE" or "DESATIVADO")
        end
        task.wait(respawnState.dead and .65 or 1.2)
    end
end)

-- Loop principal continua abaixo; mortes pausam todas as rotinas automaticamente.
task.spawn(function()
    while active do
        local ok, err = pcall(function()
            if respawnState.dead then
                task.wait(1)
            else
            -- Guard de descanso: nunca perseguir/atacar deitado apos R.
            local currentChar,currentHum=actor()
            if not restGuard.blocked and currentChar and currentHum then
                local resting,source=detectResting(currentChar,currentHum)
                if resting==true then
                    restGuard.blocked=true
                    restGuard.character=currentChar
                    restGuard.lastSource=source
                    restGuard.attempts=0
                    restGuard.lastTry=0
                    restGuard.lastWarning=0
                    warn("AUTO QUEST REST: animal detectado deitado; automacoes pausadas |",source)
                end
            end
            if restGuard.blocked and not restGateReady() then
                task.wait(1.25)
            else
            local h = getHunger()
            local t = getThirst()
            if h == nil then
                warn("Atributo Hunger nao encontrado")
                task.wait(3)
            else
                local herbivore = herbivoreState()
                local grassMode = CONFIG.AutoGrass and herbivore ~= false
                local grassQuest = grassMode and CONFIG.AutoQuest and questPending("PASTO") or nil
                local grassTrigger = grassQuest and math.max(CONFIG.GrassStart, CONFIG.QuestEatStart) or CONFIG.GrassStart
                local foodQuest = CONFIG.AutoFood and not grassMode and not CONFIG.GetAmber and questPending("COMIDA") or nil
                local drinkQuest = CONFIG.AutoDrink and not CONFIG.GetAmber and questPending("AGUA", questGenericDrink) or nil
                local hungerTrigger = foodQuest and math.max(CONFIG.HungerStart, CONFIG.QuestEatStart) or CONFIG.HungerStart
                local thirstTrigger = drinkQuest and math.max(CONFIG.DrinkStart, CONFIG.QuestDrinkStart) or CONFIG.DrinkStart
                if CONFIG.GetAmber then
                    -- O farm nao deve virar busca infinita por comida/agua aos 90%.
                    -- Para sobrevivencia, usa os mesmos minimos de amberReady().
                    hungerTrigger = CONFIG.AmberMinHunger
                    thirstTrigger = CONFIG.AmberMinThirst
                end

                if not CONFIG.AutoFood or grassMode then feeding = false end
                if not grassMode then grazing = false end
                if CONFIG.AutoGrass and herbivore == false then
                    setActivity("AutoGrass", "SOMENTE HERBIVOROS")
                end
                if grassMode and not grazing and h <= grassTrigger then
                    grazing = true
                    print("AUTO GRASS: fome", math.floor(h), "| buscando pasto")
                elseif grazing and h >= CONFIG.GrassStop then
                    grazing = false
                    setActivity("AutoGrass", "FOME RECUPERADA")
                end
                if not CONFIG.AutoDrink then drinking = false end

                if CONFIG.AutoFood and not grassMode and not feeding and h <= hungerTrigger then
                    feeding = true
                    print("FOME BAIXA:", h, "- iniciando busca de comida")
                elseif feeding and h >= CONFIG.HungerStop then
                    feeding = false
                    print("FOME RECUPERADA:", h, "- em espera")
                end

                if CONFIG.AutoDrink and t ~= nil then
                    if not drinking and t <= thirstTrigger then drinking = true end
                    if drinking and t >= CONFIG.DrinkStop then drinking = false end
                end

                -- Sede critica: primeiro a fonte mais proxima, sem caminhada longa.
                -- Sede moderada: uma quest "Drink at" conhecida tem prioridade,
                -- para contar a missao alem de hidratar o animal.
                local namedQuest = CONFIG.AutoDrink and not CONFIG.GetAmber and questPending("AGUA", function(q)
                    return namedDrinkWaypoint(q) ~= nil
                end) or nil
                if CONFIG.AutoDrink and drinking and t and t < CONFIG.QuestNamedDrinkSafetyThreshold then
                    if os.clock() >= nextDrinkTry then
                        setActivity("AutoDrink","BUSCANDO AGUA")
                        drinkOnce()
                        setActivity("AutoDrink","EM ESPERA")
                    else task.wait(0.7) end
                elseif namedQuestReady(namedQuest, t) then
                    setActivity("AutoDrink","BEBENDO NA QUEST")
                    setActivity("AutoQuest","MISSAO DE AGUA")
                    doNamedDrinkQuest(namedQuest)
                    setActivity("AutoDrink","EM ESPERA")
                    setActivity("AutoQuest","EM ESPERA")
                    if active then task.wait(0.6) end
                elseif CONFIG.AutoDrink and drinking then
                    if os.clock() >= nextDrinkTry then
                        setActivity("AutoDrink","BUSCANDO AGUA")
                        drinkOnce()
                        setActivity("AutoDrink","EM ESPERA")
                    else
                        task.wait(0.7)
                    end
                elseif grassMode and grazing then
                    setActivity("AutoFood",CONFIG.AutoFood and "PAUSADO P/ GRAMA" or "DESATIVADO")
                    local success = autoGrazeOnce()
                    setActivity("AutoGrass",CONFIG.AutoGrass and "EM ESPERA" or "DESATIVADO")
                    if active then task.wait(success and 0.5 or 1.3) end
                elseif CONFIG.AutoFood and feeding then
                    local corpse, distance, count = closestNPC(true, CONFIG.CarcassRadius)
                    if corpse then
                        print("CARCACA:", corpse.Name, "dist:", math.floor(distance))
                        setActivity("AutoFood","INDO COMER")
                        if walkToCarcass(corpse) then
                            setActivity("AutoFood","SE ALIMENTANDO")
                            if not eatCarcass(corpse) and CONFIG.AutoFood then
                                failedUntil[corpse] = os.clock() + 40
                            end
                        else
                            if CONFIG.AutoFood then failedUntil[corpse] = os.clock() + 40 end
                        end
                        setActivity("AutoFood","EM ESPERA")
                    else
                        local prey, d, aliveCount = closestNPC(false, CONFIG.HuntRadius)
                        if prey then
                            print("ALVO VIVO:", prey.Name, "dist:", math.floor(d))
                            setActivity("AutoFood","CACANDO NPC")
                            local killed = chaseAndAttack(prey)
                            setActivity("AutoFood","EM ESPERA")
                            if killed and active then
                                -- O proximo ciclo prioriza a carcaca recem criada.
                                task.wait(0.5)
                            end
                        else
                            print("Sem animais NPC acessiveis | candidatos:", aliveCount or 0)
                            task.wait(4)
                        end
                    end
                elseif CONFIG.GetAmber and not grassMode then
                    -- Get Amber e INDEPENDENTE do Auto Quest:
                    -- nao aguarda QUICK/DAILY e pode farmar com quests pendentes.
                    -- Se ambos estiverem ligados, Get Amber tem prioridade sobre quest,
                    -- evitando que as duas automacoes disputem o controle do movimento.
                    if CONFIG.AutoQuest then
                        setActivity("AutoQuest", "PAUSADO PELO GET AMBER")
                    end
                    local canFarm, reason = amberReady(true)
                    if canFarm then
                        -- Caca padrao, 1 NPC por vez, sem aura nem alcance de 50 studs.
                        local prey, d = closestNPC(false,
                            CONFIG.AmberHuntRadius, CONFIG.AmberSpecies)
                        if prey then
                            setActivity("GetAmber", "CACANDO " .. tostring(prey:GetAttribute("Species")))
                            print("GET AMBER: alvo", prey.Name, "dist", math.floor(d))
                            local killed = chaseAndAttack(prey, nil, true)
                            setActivity("GetAmber", "EM ESPERA")
                            if active then task.wait(killed and 0.8 or 1.5) end
                        else
                            setActivity("GetAmber", "SEM PRESAS PROXIMAS")
                            task.wait(3)
                        end
                    else
                        setActivity("GetAmber", reason)
                        task.wait(1.5)
                    end
                else
                    setActivity("GetAmber",(CONFIG.GetAmber and grassMode) and "PAUSADO: HERBIVORO" or "DESATIVADO")
                    if CONFIG.AutoQuest then setActivity("AutoQuest", "EM ESPERA") end
                    -- Get Amber OFF: executa normalmente as quests pendentes.
                    -- Travel nao executa em paralelo com os outros movimentos.
                    local travelQuest = CONFIG.AutoQuest and questPending("DISTANCIA") or nil
                    if travelQuest and CONFIG.QuestTravelEnabled then
                        setActivity("AutoQuest","VIAJANDO")
                        autoTravelQuest(travelQuest)
                        setActivity("AutoQuest","EM ESPERA")
                        if active then task.wait(1) end -- evita loop rapido se a rota for bloqueada
                    else
                        -- Nao bloqueia a fila por "Catch a mouse" sem NPC disponivel.
                        local huntQuest, prey, d, species, mouseMissing, huntCount =
                            nil, nil, nil, nil, false, 0
                        if CONFIG.AutoQuest and CONFIG.AutoFood and not grassMode then
                            huntQuest, prey, d, species, mouseMissing, huntCount = questHuntWithAvailablePrey()
                        end
                        if mouseMissing and os.clock() - lastMissingMouseWarning >= 30 then
                            lastMissingMouseWarning = os.clock()
                            warn("AUTO QUEST MOUSE: rato nao encontrado em FeralNPCs; " ..
                                "pulando temporariamente para outra quest")
                        end
                        if huntQuest and prey then
                            print("AUTO QUEST CACA:", huntQuest.title, "| alvo:", prey.Name,
                                "| especie:", tostring(species), "| dist:", math.floor(d))
                            setActivity("AutoQuest", "CACA DE QUEST")
                            setActivity("AutoFood", "CACANDO NPC")
                            local killed = chaseAndAttack(prey, huntQuest.title)
                            setActivity("AutoFood", "EM ESPERA")
                            setActivity("AutoQuest", "EM ESPERA")
                            if killed and active then
                                task.wait(2.2)
                                pcall(questScan)
                            end
                        else
                            if huntCount > 0 and os.clock() - lastUnavailableHuntWarning >= 25 then
                                lastUnavailableHuntWarning = os.clock()
                                print("AUTO QUEST CACA:", huntCount,
                                    "quest(s) aguardando NPC valido; tentando outra atividade")
                            end
                            -- Locais com coordenadas fornecidas pelo usuario.
                            local visitQuest = CONFIG.AutoQuest and questPending("LOCAL", function(q)
                                return namedVisitWaypoint(q) ~= nil
                                    and os.clock() >= (visitRetryAt[q.title] or 0)
                            end) or nil
                            local restQuest = CONFIG.AutoQuest and questPending("DESCANSO", function(q)
                                return os.clock() >= (restRetryAt[q.title] or 0)
                            end) or nil
                            local territoryQuest = CONFIG.AutoQuest and questPending("TERRITORIO", function(q)
                                return os.clock() >= (territoryRetryAt[q.title] or 0)
                            end) or nil
                            if visitQuest then
                                setActivity("AutoQuest","EXPLORANDO")
                                visitNamedQuest(visitQuest)
                                setActivity("AutoQuest","EM ESPERA")
                            elseif restQuest then
                                setActivity("AutoQuest","DESCANSANDO")
                                doRestQuest(restQuest)
                                setActivity("AutoQuest","EM ESPERA")
                            elseif territoryQuest then
                                setActivity("AutoQuest","TERRITORIO")
                                doTerritoryQuest(territoryQuest)
                                setActivity("AutoQuest","EM ESPERA")
                            else
                                task.wait(1.5)
                            end
                        end
                    end
                end
            end
            end -- fim do guard de descanso
            end -- fim do guard de morte / respawn
        end)
        if not active then break end
        if ok then
            runtimeStatus.consecutiveErrors = 0
            if runtimeStatus.recovering then
                for _, key in ipairs({"AutoFood", "AutoGrass", "AutoDrink", "AutoQuest", "GetAmber"}) do
                    if activity[key] == "RECUPERANDO ERRO" then
                        setActivity(key, CONFIG[key] and "EM ESPERA" or "DESATIVADO")
                    end
                end
            end
            runtimeStatus.recovering = false
        else
            runtimeStatus.consecutiveErrors += 1
            runtimeStatus.totalErrors += 1
            runtimeStatus.lastError = tostring(err)
            runtimeStatus.lastErrorAt = os.clock()
            runtimeStatus.recovering = true
            controlsEpoch += 1
            pcall(stopMovement)
            feeding, drinking = false, false
            for _, key in ipairs({"AutoFood", "AutoGrass", "AutoDrink", "AutoQuest", "GetAmber"}) do
                setActivity(key, "RECUPERANDO ERRO")
            end
            warn("THE GOAT: falha na rotina | tentativa",
                runtimeStatus.consecutiveErrors, "/ 3 |", runtimeStatus.lastError)
            if runtimeStatus.consecutiveErrors >= 3 then
                warn("THE GOAT: encerrado apos 3 falhas consecutivas; consulte getRuntimeStatus()")
                break
            end
            task.wait(runtimeStatus.consecutiveErrors * 2)
        end
    end
    runtimeStatus.recovering = false
    stop()
    print("THE GOAT FERAL V8.9.28 SESSAO " .. sessionID .. " DESLIGADA")
end)

