                Font=Enum.Font.GothamBold,TextSize=11,TextColor3=white,
                TextXAlignment=Enum.TextXAlignment.Center,BackgroundColor3=off,
                BorderSizePixel=0,PlaceholderText="10 - 100"
            }),7)
            local plus=corner(el("TextButton",adjust,{
                Text="+",Position=UDim2.fromOffset(251,9),Size=UDim2.fromOffset(42,29),
                Font=Enum.Font.GothamBold,TextSize=16,TextColor3=white,
                BackgroundColor3=off,BorderSizePixel=0
            }),7)
            lbl(speedContainer,"V alterna velocidade; pausa com navegacao automatica.",6,112,296,20,9,muted,false)
            uiRedraw=function()
                if not state.active or not speedToggle.Parent then return end
                speedToggle.Text=state.enabled and "ON" or "OFF"
                speedToggle.TextColor3=state.enabled and Color3.fromRGB(9,16,10) or white
                speedToggle.BackgroundColor3=state.enabled and lime or off
                statusText.Text=state.enabled and state.last or "OFF • tecla V"
                statusText.TextColor3=state.enabled and lime or pale
                if not value:IsFocused() then value.Text=tostring(state.speed) end
            end
            connect(speedToggle.MouseButton1Click,function() api.setEnabled(not state.enabled) end)
            connect(minus.MouseButton1Click,function() api.setSpeed(state.speed-5) end)
            connect(plus.MouseButton1Click,function() api.setSpeed(state.speed+5) end)
            connect(value.FocusLost,function() api.setSpeed(value.Text) end)
            uiRedraw()
        else
            warn("TG VELOCIDADE: aba AJUSTES indisponivel; tecla V continua funcional")
        end

        connect(UIS.InputBegan,function(input,processed)
            if not state.active or input.KeyCode~=Enum.KeyCode.V then return end
            if UIS:GetFocusedTextBox() then return end
            -- Aceitar tambem entradas processadas pelo jogo (igual ao teste V1.1).
            api.setEnabled(not state.enabled)
        end)

        connect(RunService.Heartbeat,function()
            if not state.active or not state.enabled then return end
            if type(goat.isActive)=="function" and not goat.isActive() then
                api.stop()
                return
            end
            local okMove,err=pcall(function()
                local char=player.Character
                local hum=char and char:FindFirstChildOfClass("Humanoid")
                local root=char and char:FindFirstChild("HumanoidRootPart")
                if not char or not hum or not root or hum.Health<=0 then
                    state.last="SEM PERSONAGEM"
                    return
                end
                state.stamina=char:GetAttribute("Stamina")
                state.maxStamina=char:GetAttribute("StaminaMax")
                local velocity=root.AssemblyLinearVelocity
                state.realSpeed=Vector3.new(velocity.X,0,velocity.Z).Magnitude

                -- Respeita automaticamente a navegação do THE GOAT.
                local clock=os.clock()
                if clock>=nextNavCheck then
                    nextNavCheck=clock+0.25
                    local yes,snap=pcall(goat.swimStatus)
                    navActive=yes and type(snap)=="table" and snap.movementActive==true
                end
                if navActive then
                    state.skippedNavigation+=1
                    state.last="PAUSADO: AUTO NAV"
                    return
                end
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift) then
                    state.last="SOLTE SHIFT"
                    return
                end
                local hs=hum:GetState()
                if hs==Enum.HumanoidStateType.Swimming
                    or hs==Enum.HumanoidStateType.Seated
                    or hs==Enum.HumanoidStateType.Dead
                    or hs==Enum.HumanoidStateType.Jumping
                    or hs==Enum.HumanoidStateType.Freefall
                    or hum.FloorMaterial==Enum.Material.Air then
                    state.last="PAUSADO: FORA DO SOLO"
                    return
                end
                local move=hum.MoveDirection
                local flat=Vector3.new(move.X,0,move.Z)
                if flat.Magnitude<0.15 then
                    state.last="AGUARDANDO WASD"
                    return
                end
                flat=flat.Unit
                root.AssemblyLinearVelocity=Vector3.new(flat.X*state.speed,velocity.Y,flat.Z*state.speed)
                state.last="MOVIMENTO APLICADO"
                state.applied+=1
                if clock-lastPrint>5 then
                    lastPrint=clock
                    print("TG VELOCIDADE |",state.speed,"studs/s | stamina",state.stamina,
                        "/",state.maxStamina,"| aplicacoes",state.applied)
                    uiRedraw()
                end
            end)
            if not okMove then
                state.lastError=tostring(err)
                warn("TG VELOCIDADE: erro no movimento:",state.lastError)
                api.setEnabled(false)
            end
        end)
        print("TG VELOCIDADE: instalado | V somente velocidade | Aura apenas no painel | inicial OFF | 46 studs/s")
    end)
    if not statusOK then
        warn("TG VELOCIDADE: erro de inicializacao (script principal preservado):",tostring(statusErr))
    end
end

