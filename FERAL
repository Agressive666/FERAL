        end
    end
    -- Apenas fallback de compatibilidade e SOMENTE com a janela em foco.
    -- Jamais usa keypress em segundo plano: ele nao foi confiavel no FERAL.
    if CONFIG.FeedFallbackKey and windowFocused then
        local ok=pressE() -- definido abaixo, avaliado quando esta funcao e chamada
        feedDebug.lastAction=kind
        feedDebug.lastAt=os.clock()
        feedDebug.lastMethod=ok and "TECLA E" or "FALHOU"
        if ok then feedDebug.keyboardFallbacks += 1 end
        return ok, "TECLA E"
    end
    feedDebug.lastMethod="SEM INTERACAO"
    return false, "SEM REMOTE OU FOCO"
end

pressE = function()
    if type(keypress) == "function" and type(keyrelease) == "function" then
        return pcall(function()
            keypress(0x45)
            task.wait(0.3)
            keyrelease(0x45)
        end)
    end
    return pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.3)
        vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

-- === AUTO EAT GRASS V8.9.34 ===
-- Funciona com prompts REAIS (EAT/GRAZE), nao inventa RemoteEvents de grama.
-- A estrutura exata dos patches no FERAL nao esta documentada nesta base:
-- o scanner tenta tags e nomes fisicos comuns e confirma resultado por Hunger.
local CollectionService = game:GetService("CollectionService")
local grassFailures = setmetatable({}, {__mode = "k"})
-- Uma falha pode ser um prompt EAT sem grama. Marca a POSICAO, nao somente
-- a instancia do patch: no Terrain o mesmo objeto cobre o mapa inteiro.
local failedGrassAreas = {}
local function grassFailedArea(point)
    if typeof(point) ~= "Vector3" then return false end
    local now=os.clock()
    for i=#failedGrassAreas,1,-1 do
        local entry=failedGrassAreas[i]
        if entry.untilAt<=now then
            table.remove(failedGrassAreas,i)
        elseif horizontal(point,entry.pos).Magnitude<CONFIG.GrassFailedAreaRadius then
            return true
        end
    end
    return false
end
local function markGrassFailedArea(point,reason)
    if typeof(point) ~= "Vector3" then return end
    if not grassFailedArea(point) then
        table.insert(failedGrassAreas,{pos=point,
            untilAt=os.clock()+CONFIG.GrassFailedAreaCooldown})
        if #failedGrassAreas>24 then table.remove(failedGrassAreas,1) end
    end
    print("AUTO GRASS: local sem alimento valido, buscando OUTRA AREA |",
        tostring(reason), "| XZ:",math.floor(point.X),math.floor(point.Z))
end
local grassTerrainParams=RaycastParams.new()
grassTerrainParams.FilterType=Enum.RaycastFilterType.Include
grassTerrainParams.FilterDescendantsInstances={Terrain}
grassTerrainParams.IgnoreWater=true
local grassDebug = {status="DESATIVADO", found=0, target=nil, distance=nil,
    lastPrompt=nil, lastHungerGain=nil, species=nil, scans=0}
local lastGrassNotice = -math.huge
local grassTags = {"GrassPatch", "GrassPatches", "EdibleGrass", "GrazingPatch", "Graze", "Grass", "FeralGrass"}

local function grassPromptVisible(node, screen)
    -- Prompt2 pode conservar EAT no TextLabel mesmo invisivel. Nao usar texto
    -- de um widget oculto como prova de que existe grama no local atual.
    while node and node ~= screen do
        if node:IsA("GuiObject") and not node.Visible then return false end
        node=node.Parent
    end
    return node==screen
end
local function grassPromptState()
    local text = promptState()
    local gui = player:FindFirstChild("PlayerGui")
    local screen = gui and gui:FindFirstChild("FeralPrompt")
    if screen and screen.Enabled then
        local holder=screen:FindFirstChild("Holder")
        if holder then
            -- FERAL pode mostrar DRINK no Prompt e EAT no Prompt2.
            for _, promptName in ipairs({"Prompt", "Prompt2"}) do
                local box=holder:FindFirstChild(promptName)
                local button=box and box:FindFirstChild("Button")
                local chip=button and button:FindFirstChild("Chip")
                local label=chip and chip:FindFirstChild("Text")
                if label and label:IsA("TextLabel")
                    and grassPromptVisible(label,screen) then
                    local t=string.upper(label.Text)
                    if t=="EATING" or t=="EAT" or t:find("GRAZ",1,true) then
                        text=t
                        break
                    end
                end
            end
        end
    end
    grassDebug.lastPrompt = text
    if not text then return nil end
    if text:find("GRAZ", 1, true) or text:find("GRASS", 1, true) then
        return text:find("ING", 1, true) and "EATING" or "EAT"
    end
    if text == "EAT" or text == "EATING" then return text end
    return nil
end

local function grassRank(instance)
    if not instance or not instance.Parent then return 0 end
    local s = instance.Name:lower():gsub("[^%w]", "")
    if s:find("grasspatch", 1, true) or s:find("grazingpatch", 1, true)
        or s:find("ediblegrass", 1, true) then return 5 end
    if s:find("graz", 1, true) or s:find("pasture", 1, true)
        or s:find("grazingground", 1, true) then return 4 end
    if s == "grass" or s:find("grass", 1, true) then return 2 end
    for _, attribute in ipairs({"GrassLeft", "GrassAmount", "EdibleGrass", "IsGrassPatch"}) do
        if instance:GetAttribute(attribute) ~= nil then return 4 end
    end
    return 0
end

local function scanNearbyGrass()
    local char, _, root = actor()
    if not root or not char then return nil end
    local best, bestPoint, bestDistance, bestScore = nil, nil, nil, -math.huge
    local count = 0
    local maxDistance = CONFIG.GrassSearchRadius
    local now = os.clock()
    local function consider(instance, point, rank)
        if not instance or not instance.Parent or typeof(point) ~= "Vector3" then return end
        if now < (grassFailures[instance] or 0) or grassFailedArea(point) then return end
        local remaining = instance:GetAttribute("GrassLeft") or instance:GetAttribute("FoodLeft")
        if type(remaining) == "number" and remaining <= 0 then return end
        local distance = horizontal(root.Position, point).Magnitude
        if distance > maxDistance or math.abs(root.Position.Y-point.Y) > 48 then return end
        count += 1
        -- Prioriza interativos/pedacos de grama; distancia desempata.
        local score = rank*70 - distance*0.6
        if score > bestScore then
            best, bestPoint, bestDistance, bestScore = instance, point, distance, score
        end
    end

    for _, tag in ipairs(grassTags) do
        for _, obj in ipairs(CollectionService:GetTagged(tag)) do
            if obj:IsDescendantOf(workspace) and not obj:IsDescendantOf(char) then
                local p
                if obj:IsA("BasePart") then p = obj.Position
                elseif obj:IsA("Model") then p = obj:GetPivot().Position end
                if p then consider(obj, p, 6) end
            end
        end
    end
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    local excludes = {char}
    local npcs = workspace:FindFirstChild("FeralNPCs")
    if npcs then table.insert(excludes, npcs) end
    overlap.FilterDescendantsInstances = excludes
    overlap.MaxParts = CONFIG.GrassScanMaxParts
    local ok, parts = pcall(function()
        return workspace:GetPartBoundsInRadius(root.Position, maxDistance, overlap)
    end)
    if ok and parts then
        for _, part in ipairs(parts) do
            local node = part
            for _ = 1, 5 do
                if not node or node == workspace then break end
                if (node:IsA("Model") or node:IsA("BasePart") or node:IsA("Folder")) then
                    local rank = grassRank(node)
                    if rank > 0 then
                        consider(node:IsA("Folder") and part or node, part.Position, rank)
                        break
                    end
                end
                node = node.Parent
            end
        end
    end
    -- Terrain Grass nem sempre possui uma Part ou tag. O Hippo pode nao
    -- encontrar nenhum patch nomeado mesmo quando ha gramado nas proximidades.
    -- A amostra de Terrain e SOMENTE um candidato a testar; a confirmacao real
    -- continua sendo o aumento de Hunger, nunca a simples cor do terreno.
    if not best and CONFIG.GrassTerrainFallback then
        local castCount=0
        for _, radius in ipairs({30,55,90,130,175,215}) do
            if best then break end
            for i=0,11 do
                local angle=i*math.pi/6+radius*0.007
                local offset=Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
                local sample=root.Position+offset
                local hit=workspace:Raycast(
                    Vector3.new(sample.X,root.Position.Y+75,sample.Z),
                    Vector3.new(0,-170,0),grassTerrainParams)
                castCount += 1
                if hit and (hit.Material==Enum.Material.Grass
                    or hit.Material==Enum.Material.LeafyGrass)
                    and hit.Normal.Y>=CONFIG.SafeGroundSlopeY
                    and math.abs(root.Position.Y-hit.Position.Y)<=38 then
                    consider(Terrain,hit.Position+Vector3.new(0,3,0),2)
                end
            end
        end
        grassDebug.terrainSamples=castCount
    end
    grassDebug.scans += 1
    grassDebug.found = count
    grassDebug.target = best and best:GetFullName() or nil
    grassDebug.distance = bestDistance
    return best, bestPoint, bestDistance
end

-- === AUTO GRASS EXPLORADOR V8.9.34 ===
-- Quando nao ha grama conhecida no raio local, avanca por terrenos secos
-- usando o mesmo navegador seguro. Faz scan apenas AO REDOR do personagem,
-- nao tenta varrer todo o workspace em um unico frame.
local grassExplore = {
    anchor=nil, character=nil, step=0, destination=nil,
    searched=0, reached=0, lastOutcome="EM ESPERA", retryAt=0
}

local function resetGrassExplore(keepCharacter)
    grassExplore.anchor=nil
    grassExplore.destination=nil
    grassExplore.step=0
    grassExplore.retryAt=0
    if not keepCharacter then grassExplore.character=nil end
end

local function grassExploreDestination(root)
    if not root or not root.Parent then return nil end
    local char=player.Character
    if grassExplore.character~=char then
        resetGrassExplore()
        grassExplore.character=char
    end
    if not grassExplore.anchor then grassExplore.anchor=root.Position end
    if grassExplore.step>=CONFIG.GrassExploreMaxSteps then
        -- Sai do setor anterior e continua a busca a partir da posicao atual.
        grassExplore.anchor=root.Position
        grassExplore.step=0
        print("AUTO GRASS: novo setor de exploracao; anterior sem grama reconhecida")
    end
    for attempt=1,9 do
        grassExplore.step += 1
        local n=grassExplore.step
        local radius=math.min(CONFIG.GrassExploreMaxRadius,
            95 + math.sqrt(n)*CONFIG.GrassExploreStep)
        -- Angulo aureo: visita varios lados sem repetir sempre o mesmo corredor.
        local a=n*2.399963229728653
        local home=grassExplore.anchor
        local x=home.X+math.cos(a)*radius
        local z=home.Z+math.sin(a)*radius
        -- Usa apenas Terrain como apoio: nao confunde telhados, plantas e NPCs com piso.
        local ground=workspace:Raycast(Vector3.new(x,root.Position.Y+140,z),
            Vector3.new(0,-320,0),waterParams)
        if ground and ground.Material~=Enum.Material.Water
            and ground.Normal.Y>=CONFIG.SafeGroundSlopeY
            and math.abs(root.Position.Y-ground.Position.Y)<100 then
            local point=ground.Position + Vector3.new(0,3,0)
            if horizontal(root.Position,point).Magnitude>35
                and not grassFailedArea(point) then
                grassExplore.destination=point
                return point
            end
        end
    end
    return nil
end

local function exploreForGrass(char, hum, root, epoch, stopForWater)
    if not CONFIG.GrassExploreEnabled then return false end
    if os.clock()<grassExplore.retryAt then
        setActivity("AutoGrass","PAUSA: SEM PASTO")
        return false
    end
    local destination=grassExploreDestination(root)
    if not destination then
        grassExplore.lastOutcome="SEM TERRENO SEGURO"
        grassExplore.retryAt=os.clock()+CONFIG.GrassExploreBlockedPause
        setActivity("AutoGrass","SEM ROTA SEGURA")
        return false
    end
    grassExplore.searched += 1
    grassExplore.lastOutcome="EXPLORANDO"
    grassDebug.status="EXPLORANDO AREA SEM GRAMA"
    setActivity("AutoGrass","EXPLORANDO PASTO")
    print("AUTO GRASS: sem grama a",CONFIG.GrassSearchRadius,
        "studs | explorando ponto",grassExplore.step,
        "| distancia",math.floor(horizontal(root.Position,destination).Magnitude))
    local getDist=startMovement(hum,root,
        function() return destination end, function() return 11 end,
        CONFIG.GrassExploreSpeed)
    local started=os.clock()
    local lastScan=0
    local lastDistance=math.huge
    local lastProgress=started
    local found=false
    local arrived=false
    while active and CONFIG.AutoGrass and controlsEpoch==epoch
        and player.Character==char and root.Parent and hum.Health>0
        and os.clock()-started < CONFIG.GrassExploreTravelTimeout do
        task.wait(0.35)
        if stopForWater() or (getHunger() or 100)>=CONFIG.GrassStop then
            grassExplore.lastOutcome="INTERROMPIDO POR SEDE/FOME RECUPERADA"
            break
        end
        -- EAT pode ser um prompt generico de comida, ou stale no Hippo.
        -- Ignora EAT em local onde Feed nao aumentou Hunger.
        if grassPromptState() and not grassFailedArea(root.Position) then
            found=true
            break
        end
        local now=os.clock()
        if now-lastScan>=CONFIG.GrassExploreScanInterval then
            lastScan=now
            local nearby=scanNearbyGrass()
            if nearby then found=true; break end
        end
        local d,reached,blocked=getDist()
        if d+1.5<lastDistance then lastDistance=d; lastProgress=now end
        if reached or d<=11 then arrived=true; break end
        if blocked or now-lastProgress>math.min(CONFIG.StuckTimeout,12) then
            grassExplore.lastOutcome="CAMINHO BLOQUEADO"
            break
        end
    end
    stopMovement()
    if found then
        grassExplore.lastOutcome="GRAMADO DETECTADO"
        grassDebug.status="GRAMA DETECTADA NA EXPLORACAO"
        setActivity("AutoGrass","GRAMA ENCONTRADA")
        resetGrassExplore(true)
        return true
    end
    if arrived then
        grassExplore.reached += 1
        grassExplore.lastOutcome="SETOR VERIFICADO"
    elseif grassExplore.lastOutcome=="EXPLORANDO" then
        grassExplore.lastOutcome="PROXIMO SETOR"
    end
    setActivity("AutoGrass","PROCURANDO OUTRA AREA")
    return false
end

local function autoGrazeOnce()
    if not CONFIG.AutoGrass then return false end
    local char, hum, root = actor()
    if not char or hum.Health <= 0 then return false end
    local herbivore, species = herbivoreState()
    grassDebug.species = species
    if herbivore ~= true then
        setActivity("AutoGrass", "ESPECIE NAO HERBIVORA/NAO IDENTIFICADA")
        if os.clock()-lastGrassNotice > 25 then
            warn("AUTO GRASS: especie sem dieta herbivora confirmada:",species)
            lastGrassNotice=os.clock()
        end
        return false
    end
    local epoch = controlsEpoch
    local stopForWater = function()
        local thirst = getThirst()
        return CONFIG.AutoDrink and thirst and thirst <= CONFIG.DrinkStart
    end
    if stopForWater() then return false end
    local patch = nil
    -- O mesmo prompt EAT pode persistir em local sem grama comestivel.
    -- Apos uma falha ele nao pode interromper a busca por outra area.
    local prompt = not grassFailedArea(root.Position) and grassPromptState() or nil
    if not prompt then
        local target, point, distance = scanNearbyGrass()
        patch = target
        if not patch then
            grassDebug.status="SEM GRAMA DETECTADA"
            setActivity("AutoGrass", "BUSCANDO OUTRA AREA")
            if CONFIG.GrassExploreEnabled then
                exploreForGrass(char, hum, root, epoch, stopForWater)
            else
                if os.clock()-lastGrassNotice >= 15 then
                    warn("AUTO GRASS: nao encontrou grama no raio local; exploracao OFF")
                    lastGrassNotice=os.clock()
                end
                task.wait(2)
            end
            return false
        end
        -- Ao encontrar grama acessivel, a proxima exploracao inicia neste setor.
        if grassExplore.anchor then resetGrassExplore(true) end
        grassDebug.status="INDO PARA GRAMA"
        setActivity("AutoGrass", "INDO PARA GRAMA")
        local getDistance = startMovement(hum,root,
            function() return point end, function() return 5.5 end, CONFIG.GrassMoveSpeed)
        local started=os.clock()
        local arrived=false
        local stalledSince=started
        local lastDistance=math.huge
        while active and CONFIG.AutoGrass and controlsEpoch==epoch and player.Character==char
            and patch.Parent and os.clock()-started<CONFIG.GrassTravelTimeout do
            task.wait(0.3)
            if stopForWater() or (getHunger() or 100) >= CONFIG.GrassStop then break end
            if grassPromptState() and not grassFailedArea(root.Position) then
                arrived=true; break
            end
            local d,reached,blocked=getDistance()
            if d+1.3 < lastDistance then lastDistance=d; stalledSince=os.clock() end
            if blocked or os.clock()-stalledSince>=CONFIG.StuckTimeout then break end
            if reached or d<=5.5 then
                task.wait(1.1)
                arrived=(grassPromptState()~=nil and not grassFailedArea(root.Position)) or
                    (horizontal(root.Position,point).Magnitude<=7 and
                        math.abs(root.Position.Y-point.Y)<=10)
                break
            end
        end
        stopMovement()
        -- Mesmo sem UI atualizada no background, se esta junto ao patch
        -- pode tentar o Feed remoto; o servidor valida a interacao.
        if not arrived and patch.Parent and
            horizontal(root.Position,point).Magnitude<=7 and
            math.abs(root.Position.Y-point.Y)<=10 then
            arrived=true
        end
        if not arrived then
            if patch~=Terrain then grassFailures[patch]=os.clock()+CONFIG.GrassFailedCooldown end
            markGrassFailedArea(point,"PATCH SEM PROMPT/SEM ACESSO")
            grassDebug.status="PATCH SEM PROMPT"
            setActivity("AutoGrass", "TENTANDO OUTRA GRAMA")
            return false
        end
    end

    grassDebug.status="COMENDO GRAMA"
    setActivity("AutoGrass", "COMENDO GRAMA")
    local started=os.clock()
    local previous=getHunger() or 0
    local lastGain=started
    local lastPress=-math.huge
    local missingSince=nil
    local confirmed=false
    while active and CONFIG.AutoGrass and controlsEpoch==epoch and player.Character==char
        and root.Parent and os.clock()-started<CONFIG.GrassEatTimeout do
        local hunger=getHunger()
        if not hunger then break end
        if hunger>=CONFIG.GrassStop then
            grassDebug.status="FOME RECUPERADA"
            setActivity("AutoGrass", "FOME RECUPERADA")
            return true
        end
        if stopForWater() then break end
        local state=grassPromptState()
        local nearPatch=patch and patch.Parent and
            ((patch==Terrain and point and horizontal(root.Position,point).Magnitude<=12)
                or (patch~=Terrain and horizontal(root.Position,patch:GetPivot().Position).Magnitude<=12))
        -- Com Roblox minimizado a GUI pode ficar desatualizada; a proximidade
        -- de um patch previamente localizado permite testar Feed sem tecla E.
        if state=="EATING" and os.clock()-lastGain<=4 then
            -- Nao cancela a animacao/estado de comer enquanto a fome sobe.
            missingSince=nil
        elseif state=="EAT" or nearPatch or
            (state=="EATING" and os.clock()-lastGain>4) then
            missingSince=nil
            if os.clock()-lastPress>=2.8 and
                (not confirmed or os.clock()-lastGain>3) then
                lastPress=os.clock()
                local ok,method=feedInteraction("eat")
                if ok then
                    grassDebug.lastFeedMethod=method
                    print("AUTO GRASS: Feed eat via",method)
                end
            end
        else
            missingSince=missingSince or os.clock()
            if os.clock()-missingSince>=5 then break end
        end
        task.wait(0.65)
        local after=getHunger()
        if after and after>previous+0.05 then
            previous=after
            lastGain=os.clock()
            confirmed=true
            grassDebug.lastHungerGain=after
            if math.floor(after)%5==0 then
                print("AUTO GRASS: alimentacao confirmada | FOOD",math.floor(after),"%")
            end
        end
        if os.clock()-lastGain>CONFIG.GrassFeedNoGainSeconds then break end
    end
    if confirmed then
        grassDebug.status="COMEU (CONFIRMADO)"
        return true
    end
    if patch and patch~=Terrain then grassFailures[patch]=os.clock()+CONFIG.GrassFailedCooldown end
    markGrassFailedArea(root.Position,"FEED SEM AUMENTO DE HUNGER")
    grassDebug.status="SEM AUMENTO DE FOME"
    if os.clock()-lastGrassNotice>=12 then
        warn("AUTO GRASS: prompt nao resultou em aumento de Hunger; mudando de patch")
        lastGrassNotice=os.clock()
    end
    return false
end

