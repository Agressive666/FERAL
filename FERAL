-- === V8.9.34 | ALVO MOVEL ===
-- Posicao prevista + estimativa da velocidade; nao teleporta o personagem.
-- O controlador de movimento continua unico e o anti-queda permanece ativo.
local function makePreyTracker(npc, ourRoot, leadSeconds, maxLead)
    local lastPos = nil
    local lastAt = 0
    local sampledVelocity = Vector3.zero

    local function readPrey()
        if not npc or not npc.Parent then return ourRoot.Position, Vector3.zero end
        local position = npc:GetPivot().Position
        local now = os.clock()
        if lastPos == nil then
            lastPos, lastAt = position, now
        elseif now - lastAt >= 0.11 then
            local delta = horizontal(lastPos, position) / math.max(0.01, now-lastAt)
            if delta.Magnitude <= 115 then
                sampledVelocity = sampledVelocity:Lerp(delta, 0.6)
            end
            lastPos, lastAt = position, now
        end
        local body = npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart", true)
        if body and not body.Anchored then
            local v = body.AssemblyLinearVelocity
            local flat = Vector3.new(v.X, 0, v.Z)
            if flat.Magnitude >= 1.5 and flat.Magnitude <= 115 then
                sampledVelocity = sampledVelocity:Lerp(flat, 0.5)
            end
        end
        return position, sampledVelocity
    end

    local function predictedPosition()
        local p, velocity = readPrey()
        local dist = horizontal(ourRoot.Position, p).Magnitude
        local preview = math.min(leadSeconds, 0.10 + dist / 250)
        -- Ao chegar perto, perseguir a posicao real evita passar pela presa.
        local closeRange = math.max(5, CONFIG.AttackDistance + 2)
        local predictionScale = math.clamp((dist - closeRange) / 15, 0, 1)
        local offset = velocity * preview * predictionScale
        if offset.Magnitude > maxLead then offset = offset.Unit * maxLead end
        return p + offset
    end

    local function getVelocity()
        local _, v = readPrey()
        return v
    end
    local function getActualPosition()
        local p = readPrey()
        return p
    end
    return predictedPosition, getVelocity, getActualPosition
end

local function startMovement(hum, root, targetPosition, stopDistance, speedOverride, allowWater, followOptions, travelOptions)
    if not active or not hum or not root or not hum.Parent or not root.Parent
        or hum.Health <= 0 then
        return function() return math.huge, false, true, "CANCELADO", "SEM PERSONAGEM ATIVO" end
    end
    local speedLimit = followOptions and CONFIG.HuntMaxSpeed or CONFIG.SafeMaxSpeed
    stopMovement()
    movementHum, movementRoot = hum, root
    savedWalkSpeed = hum.WalkSpeed
    savedAutoRotate = hum.AutoRotate
    savedAlign = root:FindFirstChild("WolfAlign")
    if savedAlign and savedAlign:IsA("AlignOrientation") then
        savedAlignEnabled = savedAlign.Enabled
        savedAlign.Enabled = false
    else
        savedAlign = nil
        savedAlignEnabled = nil
    end
    hum.AutoRotate = false

    local character = hum.Parent
    local cast = RaycastParams.new()
    cast.FilterType = Enum.RaycastFilterType.Exclude
    cast.FilterDescendantsInstances = {character}
    cast.IgnoreWater = false
    pcall(function() cast.RespectCanCollide = true end)

    local distance, reached = math.huge, false
    local epoch = controlsEpoch
    local nav = {
        points = nil, index = 1, target = nil,
        lastPath = -math.huge, computing = false,
        steer = nil, steerUntil = 0,
        lastCheck = 0, cachedDirection = nil,
        blockedSince = nil, lastMoving = os.clock(),
        lastProgress = os.clock(), bestDist = math.huge,
        lastPosition = root.Position, safePosition = root.Position,
        lastSafeSample = 0, failed = false,
        preference = 1, mode = "DIRETO",
        lastLog = -math.huge, lastReason = "",
        pathFailures = 0
    }

    local function trace(message, forced)
        local now = os.clock()
        if forced or now - nav.lastLog >= CONFIG.NavLogInterval then
            nav.lastLog = now
            local entry = string.format("[THE GOAT NAV] %s | distancia: %d | destino: %s", 
                tostring(message), math.floor(distance), tostring(nav.target or "dinamico"))
            table.insert(navLog, entry)
            if #navLog > 60 then table.remove(navLog, 1) end
            print(entry)
        end
    end

    local function halt()
        hum:Move(Vector3.zero, false)
        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
    end

    local function groundAt(point, referenceY)
        -- Usa a altura atual do animal como referencia. A versao antiga usava
        -- raycast muito alto, podendo acertar vegetacao acima da cabeca.
        local y = referenceY or root.Position.Y
        local origin = Vector3.new(point.X, y + 5.5, point.Z)
        return workspace:Raycast(origin, Vector3.new(0, -29, 0), cast)
    end

    local function safeStep(from, direction, lookAhead)
        if not CONFIG.SafeNavigation then return true, "SEM_FILTRO" end
        if not direction or direction.Magnitude < 0.05 then return false, "DIRECAO_ZERO" end
        local dir = Vector3.new(direction.X, 0, direction.Z).Unit
        local here = groundAt(from, from.Y)
        if not here then return false, "SEM_SOLO_ATUAL" end
        if from.Y - here.Position.Y > 9 then return false, "SEM_APOIO" end

        local prevY = here.Position.Y
        for _, f in ipairs({0.33, 0.66, 1}) do
            local probe = from + dir * (lookAhead * f)
            local ground = groundAt(probe, from.Y)
            if not ground then return false, "SEM_SOLO_FRENTE" end
            local diff = ground.Position.Y - prevY
            if ground.Material == Enum.Material.Water then
                if (travelOptions and travelOptions.dryOnly)
                    or not (CONFIG.WaterAllowCrossing or allowWater) then
                    return false, "AGUA_FRENTE"
                end
                -- O nivel da agua nao e um degrau solido; mantem o filtro anti-queda.
                if math.abs(from.Y - ground.Position.Y) > 10 then
                    return false, "QUEDA_ATE_AGUA"
                end
            else
                if diff < -CONFIG.SafeMaxDrop then return false, "QUEDA" end
                if diff > CONFIG.SafeMaxClimb then return false, "DEGRAU_ALTO" end
                if ground.Normal.Y < CONFIG.SafeGroundSlopeY then return false, "LADEIRA" end
            end
            prevY = ground.Position.Y
        end

        -- Sonda de colisao frontal. Ignora inclinacoes transitaveis.
        for _, offset in ipairs({0.3, 1.7}) do
            local hit = workspace:Raycast(from + Vector3.new(0, offset, 0), dir * lookAhead, cast)
            if hit and hit.Distance < lookAhead - 0.65 and hit.Normal.Y < 0.67 then
                return false, "PAREDE"
            end
        end
        return true, "LIVRE"
    end

    local function recalc(goal, prefer)
        -- A descida ja possui rota calculada por amostras do terreno.
        if travelOptions and travelOptions.routePlanned then return end
        local now = os.clock()
        if nav.computing or now - nav.lastPath < CONFIG.SafePathRecalc then return end
        nav.computing = true
        nav.lastPath = now
        local here = root.Position
        local delta = horizontal(here, goal)
        local direction = delta.Magnitude > 0.1 and delta.Unit or prefer
        local localGoal = goal
        if delta.Magnitude > 55 then
            localGoal = here + direction * 45
        end
        local floor = groundAt(localGoal, here.Y)
        if floor then localGoal = Vector3.new(localGoal.X, floor.Position.Y + 2, localGoal.Z) end
        local sessionEpoch = epoch
        task.spawn(function()
            local ok, points = pcall(function()
                local path = PathfindingService:CreatePath({
                    AgentRadius = 3, AgentHeight = 5,
                    AgentCanJump = false, AgentCanClimb = false,
                    WaypointSpacing = 5
                })
                path:ComputeAsync(here, localGoal)
                if path.Status ~= Enum.PathStatus.Success then return nil end
                local waypoints = path:GetWaypoints()
                if #waypoints < 2 then return nil end
                for _, wp in ipairs(waypoints) do
                    if wp.Action == Enum.PathWaypointAction.Jump then return nil end
                end
                return waypoints
            end)
            nav.computing = false
            if not active or sessionEpoch ~= controlsEpoch or movementRoot ~= root then return end
            if ok and points then
                nav.points = points
                nav.index = 2
                nav.target = goal
                nav.cachedDirection = nil
                nav.pathFailures = 0
                trace("Caminho alternativo encontrado: " .. #points .. " pontos", true)
            else
                nav.pathFailures += 1
                trace("Pathfinding sem rota: tentativa " .. nav.pathFailures)
            end
        end)
    end

    local function waypointDirection(from, goal)
        if not nav.points then return nil end
        if nav.target and horizontal(nav.target, goal).Magnitude > 20 then
            nav.points, nav.target = nil, nil
            return nil
        end
        while nav.points and nav.index <= #nav.points do
            local point = nav.points[nav.index]
            local delta = horizontal(from, point.Position)
            if delta.Magnitude > 3.2 then return delta.Unit end
            nav.index += 1
        end
        nav.points, nav.target = nil, nil
        return nil
    end

    local function rotate(direction, deg)
        local a = math.rad(deg)
        return Vector3.new(direction.X * math.cos(a) - direction.Z * math.sin(a),
            0, direction.X * math.sin(a) + direction.Z * math.cos(a))
    end

    local function selectDirection(from, wanted, direct)
        local probe = (travelOptions and travelOptions.lookAhead) or CONFIG.SafeLookAhead
        local ok, reason = safeStep(from, wanted, probe)
        if ok then return wanted, "DIRETO", reason end
        if nav.steer and os.clock() < nav.steerUntil then
            local steerOk = safeStep(from, nav.steer, probe)
            if steerOk then return nav.steer, "CONTORNO", reason end
        end
        local best, bestScore = nil, -math.huge
        -- Testa lados e pequenas reversoes: permite recuar de becos e pedras.
        -- Nao avanca se a sonda de solo indicar queda ou parede.
        local angles = {30, -30, 55, -55, 80, -80, 110, -110, 140, -140, 170, -170, 180}
        for _, angle in ipairs(angles) do
            local candidate = rotate(direct, angle)
            local pass = safeStep(from, candidate, probe)
            if pass then
                local progress = candidate:Dot(direct)
                local stable = nav.steer and candidate:Dot(nav.steer) * 0.35 or 0
                local side = ((angle > 0 and 1 or -1) == nav.preference) and 0.1 or 0
                local score = progress + stable + side
                if score > bestScore then best, bestScore = candidate, score end
            end
        end
        if best then
            nav.steer = best
            nav.steerUntil = os.clock() + 1.7
            return best, "CONTORNO", reason
        end
        -- Quando todos os caminhos longos falham, um passo curto pode permitir
        -- sair de uma depressao sem cair em um penhasco.
        for _, angle in ipairs({90, -90, 135, -135, 180}) do
            local candidate = rotate(direct, angle)
            if safeStep(from, candidate, 2.4) then
                nav.steer = candidate
                nav.steerUntil = os.clock() + 0.5
                return candidate, "RECUO_CURTO", reason
            end
        end
        return nil, "BLOQUEADO", reason
    end

    movementConnection = RunService.Heartbeat:Connect(function()
        if not active or epoch ~= controlsEpoch or not hum.Parent or not root.Parent
            or hum.Health <= 0 or player.Character ~= character then
            stopMovement()
            return
        end
        if nav.failed then
            -- Se entrar na agua apos falha de caminho, o nado/resgate assume.
            if hum:GetState() ~= Enum.HumanoidStateType.Swimming then
                halt()
                return
            end
            nav.failed = false
            nav.blockedSince = nil
        end
        local goal = targetPosition()
        if not validPosition(goal) then return end
        local from = root.Position
        local delta = horizontal(from, goal)
        distance = delta.Magnitude
        local now = os.clock()
        -- Mantem a natacao nativa, o resgate apos 10s sem progresso e o
        -- retorno a terra da V8.9.15. Nao usa sprint nem pathfinding na agua.
        if CONFIG.WaterSafetyEnabled and now >= nextWaterSafetyCheck then
            nextWaterSafetyCheck = now + CONFIG.WaterGuardCheckInterval
            lastWaterMaterial, lastWaterSurface = surfaceAt(from)
            if safeLandCharacter ~= player.Character then
                safeLandCharacter = player.Character
                safeLandPosition = nil
            end
            if lastWaterMaterial and lastWaterMaterial ~= Enum.Material.Water
                and hum:GetState() ~= Enum.HumanoidStateType.Swimming then
                safeLandPosition = from
            end
        end
        local swimmingNow = hum:GetState() == Enum.HumanoidStateType.Swimming
        local waterDetected = swimmingNow or (lastWaterMaterial == Enum.Material.Water
            and lastWaterSurface and from.Y <= lastWaterSurface.Y + 2.7)
        local rescueDir, rescueSpeed, rescuing = nil, nil, false
        if CONFIG.WaterSafetyEnabled and waterDetected then
            rescueDir, rescueSpeed, rescuing = rescueFromWater(hum, root, CONFIG.WaterRescueSpeed, goal)
        end
        if rescuing then
            reached = false
            hum:Move(rescueDir, false)
            faceTarget(root, from + rescueDir * 10, false)
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(rescueDir.X * rescueSpeed,
                math.max(v.Y, CONFIG.WaterRescueLift), rescueDir.Z * rescueSpeed)
            nav.mode = "RESGATE_AGUA"
            nav.lastMoving = now
            return
        elseif swimmingNow and CONFIG.WaterSwimNativeFirst and distance > 0.1 then
            reached = false
            nav.mode = "NATACAO"
            if savedAlign and savedAlign.Parent and savedAlignEnabled ~= nil then
                savedAlign.Enabled = savedAlignEnabled
            end
            hum.AutoRotate = true
            local swimDir = delta.Unit
            hum.WalkSpeed = CONFIG.WaterSwimSpeed
            hum:Move(swimDir, false)
            if waterSafety.nativeAt == 0 then
                waterSafety.nativeAt = now
                waterSafety.nativePos = from
            end
            if waterSafety.nativePos and horizontal(from, waterSafety.nativePos).Magnitude >= 3 then
                waterSafety.nativeAt = now
                waterSafety.nativePos = from
            end
            if now - waterSafety.nativeAt > CONFIG.WaterSwimFallbackSeconds then
                local v = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(
                    swimDir.X * CONFIG.WaterSwimSpeed,
                    math.max(v.Y, CONFIG.WaterSwimRiseSpeed),
                    swimDir.Z * CONFIG.WaterSwimSpeed)
            end
            nav.lastMoving = now
            return
        end
        waterSafety.nativeAt = 0
        waterSafety.nativePos = nil
        if savedAlign and savedAlign.Parent then savedAlign.Enabled = false end
        hum.AutoRotate = false
        if distance <= stopDistance() then
            reached = true
            nav.failed = false
            -- Presa em movimento: acompanhar a velocidade dela em vez de
            -- parar completamente a cada frame e deixa-la escapar.
            if followOptions and type(followOptions.velocity) == "function" then
                local v = followOptions.velocity()
                local flat = typeof(v)=="Vector3" and Vector3.new(v.X,0,v.Z) or Vector3.zero
                if flat.Magnitude > 1.2 then
                    local direction = flat.Unit
                    local okStep = safeStep(from, direction, math.min(6, CONFIG.SafeLookAhead))
                    if okStep then
                        local chaseSpeed = math.min(flat.Magnitude, speedLimit)
                        hum.WalkSpeed = 19.5
                        hum:Move(direction, false)
                        local previous = root.AssemblyLinearVelocity
                        root.AssemblyLinearVelocity = Vector3.new(
                            direction.X*chaseSpeed, previous.Y, direction.Z*chaseSpeed)
                        local look = type(followOptions.lookAt)=="function" and
                            followOptions.lookAt() or goal
                        faceTarget(root, look, false)
                        nav.mode = "COLADO_NA_PRESA"
                        nav.lastMoving, nav.lastProgress = now, now
                        return
                    end
                end
            end
            halt()
            return
        end
        reached = false
        if distance < 0.01 then return end
        local direct = delta.Unit
        local desired = waypointDirection(from, goal) or direct
        if distance < nav.bestDist - 2 then
            nav.bestDist, nav.lastProgress = distance, now
        end
        if horizontal(from, nav.lastPosition).Magnitude > 1.2 then
            nav.lastPosition, nav.lastMoving = from, now
            if now - nav.lastSafeSample > 1 then
                nav.lastSafeSample = now
                nav.safePosition = from
            end
        end

        -- Verificar trajetoria no maximo 7x/segundo.
        if now - nav.lastCheck > CONFIG.NavCheckInterval or nav.cachedDirection == nil then
            nav.lastCheck = now
            local dir, mode, reason = selectDirection(from, desired, direct)
            nav.cachedDirection = dir
            nav.mode = mode
            nav.lastReason = reason
            if mode ~= "DIRETO" then
                nav.blockedSince = nav.blockedSince or now
                if now - nav.blockedSince > 0.7 then recalc(goal, direct) end
            else
                nav.blockedSince = nil
                nav.steer = nil
            end
        end

        -- Sem movimento real por varios segundos: nova rota e troca de lado.
        if now - nav.lastMoving > CONFIG.NavStuckSeconds
            or now - nav.lastProgress > 7 then
            nav.points, nav.target, nav.cachedDirection = nil, nil, nil
            nav.steer = nil
            nav.preference = -nav.preference
            nav.lastMoving, nav.lastProgress = now, now
            nav.bestDist = distance
            recalc(goal, direct)
            trace("ANTI-TRAVA: trocando lado e recalculando; pos=" .. tostring(from), true)
        end

        local direction = nav.cachedDirection
        if not direction then
            halt()
            if nav.blockedSince == nil then nav.blockedSince = now end
            recalc(goal, direct)
            trace("BLOQUEADO: " .. nav.lastReason .. "; aguardando caminho seguro")
        else
            local speed = CONFIG.Speed
            if type(speedOverride) == "function" then
                speed = speedOverride(distance)
            elseif type(speedOverride) == "number" then
                speed = speedOverride
            end
            -- Sprint apenas na trajetoria direta; desacelera ao chegar perto
            -- do animal e nos contornos, preservando os testes anti-queda.
            speed = math.min(math.max(0, speed), speedLimit)
            if nav.mode == "RECUO_CURTO" then
                speed = math.min(speed, CONFIG.NavRecoverySpeed)
            elseif nav.mode == "CONTORNO" then
                speed = math.min(speed, CONFIG.NavCornerSpeed)
            elseif followOptions and type(followOptions.velocity)=="function" then
                -- Perseguicao: nao frear para 14/27 se a presa ainda corre.
                -- Perseguicao tem limite proprio em terreno livre.
                local targetV = followOptions.velocity()
                local pace = typeof(targetV)=="Vector3" and
                    Vector3.new(targetV.X,0,targetV.Z).Magnitude or 0
                local needed = math.min(speedLimit, pace + CONFIG.HuntCatchUpBonus)
                if distance < 12 then
                    -- Mantem vantagem de velocidade para fechar a distancia.
                    speed = math.min(math.max(pace + CONFIG.HuntCatchUpBonus, 20), speedLimit)
                elseif distance < 30 then
                    speed = math.min(math.max(speed, needed, 48), speedLimit)
                end
            elseif distance < 12 then
                speed = math.min(speed, 27)
            elseif distance < 30 then
                speed = math.min(speed, 43)
            end
            -- Preserva o controlador customizado, mas limita a velocidade fisica.
            hum.WalkSpeed = 19.5
            faceTarget(root, from + direction * 8, false)
            hum:Move(direction, false)
            local velocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(direction.X * speed, velocity.Y, direction.Z * speed)
            if nav.mode ~= "DIRETO" then
                trace("DESVIO: " .. nav.mode .. " | obstaculo=" .. nav.lastReason)
            end
        end

        if nav.blockedSince and now - nav.blockedSince >= CONFIG.NavAbortSeconds
            and (not direction or now - nav.lastProgress >= CONFIG.NavAbortSeconds) then
            nav.failed = true
            halt()
            trace("SEM ROTA SEGURA apos " .. CONFIG.NavAbortSeconds .. "s; soltando movimento", true)
            -- As rotinas externas continuam responsaveis pelo timeout da quest.
            nav.blockedSince = now
        end
    end)

    return function()
        return distance, reached, nav.failed or waterSafety.rescuing, nav.mode, nav.lastReason
    end
end

local function promptState()
    local gui = player:FindFirstChild("PlayerGui")
    local screen = gui and gui:FindFirstChild("FeralPrompt")
    if not screen or not screen.Enabled then return nil end
    local ok, label = pcall(function()
        return screen.Holder.Prompt.Button.Chip.Text
    end)
    if not ok or not label then return nil end
    local obj = label
    while obj and obj ~= screen do
        if obj:IsA("GuiObject") and not obj.Visible then return nil end
        obj = obj.Parent
    end
    return string.upper(label.Text)
end

