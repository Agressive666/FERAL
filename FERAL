-- O scanner confirmou 55 animais vivos; nil em FeralDead significa vivo,
-- nao usamos 'FeralDead == false' nem exigimos o atributo FeralNPC.
local HERBIVORE_SPECIES = {
    deer=true, elk=true, bison=true, moose=true, goat=true,
    hare=true, rabbit=true, porcupine=true, antelope=true, gazelle=true
}

local function closestNPC(wantDead, maxRadius, speciesFilter)
    local _, _, root = actor()
    local folder = workspace:FindFirstChild("FeralNPCs")
    if not root or not folder then return nil end
    local closest, nearest = nil, maxRadius
    local candidates = 0
    for _, npc in ipairs(folder:GetChildren()) do
        if npc:IsA("Model") and os.clock() >= (failedUntil[npc] or 0) then
            local dead = npc:GetAttribute("FeralDead") == true
            if dead == wantDead then
                local food = npc:GetAttribute("FoodLeft")
                local eligible = not wantDead or (type(food) == "number" and food > 0)
                local speciesOK = not speciesFilter
                local sp = tostring(npc:GetAttribute("Species") or ""):lower()
                local modelName = npc.Name:lower()
                local prefix = modelName:match("^([^_]+)") or modelName
                if type(speciesFilter) == "string" then
                    local wanted = speciesFilter:lower()
                    if wanted == "herbivore" then
                        speciesOK = HERBIVORE_SPECIES[sp] == true or HERBIVORE_SPECIES[prefix] == true
                    else
                        speciesOK = sp == wanted or modelName == wanted or prefix == wanted
                    end
                elseif type(speciesFilter) == "table" then
                    for _, kind in ipairs(speciesFilter) do
                        local wanted = tostring(kind):lower()
                        if sp == wanted or prefix == wanted then
                            speciesOK = true
                            break
                        end
                    end
                end
                if eligible and speciesOK then
                    local p = foodPosition(npc)
                    if validPosition(p) and math.abs(root.Position.Y - p.Y) < 80 then
                        local d = horizontal(root.Position, p).Magnitude
                        if d <= maxRadius then
                            candidates += 1
                            if d < nearest then
                                nearest, closest = d, npc
                            end
                        end
                    end
                end
            end
        end
    end
    return closest, nearest, candidates
end

-- Caso rato nao esteja no mundo de NPCs, continuar outra quest valida.
local function questHuntWithAvailablePrey()
    local missingMouse, pending = false, 0
    for _, q in ipairs(currentQuests()) do
        if not q.done and q.category == "CACA" then
            pending += 1
            local species = questHuntSpecies(q)
            if species then
                local prey, d = closestNPC(false, CONFIG.HuntRadius, species)
                if prey then
                    return q, prey, d, species, missingMouse, pending
                elseif species == "Mouse" then
                    missingMouse = true
                end
            end
        end
    end
    return nil, nil, nil, nil, missingMouse, pending
end
