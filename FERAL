local function terrCoords(a,b)
    if typeof(a)=="Vector2" then return a.X,a.Y end
    if typeof(a)=="Vector3" then return a.X,a.Z end
    if type(a)=="number" and type(b)=="number" then return a,b end
    if type(a)=="table" then
        local x=a.X or a.x or a[1]
        local z=a.Z or a.z or a.Y or a.y or a[2]
        if type(x)=="number" and type(z)=="number" then return x,z end
    end
    return nil,nil
end
local function terrHexPair(a,b)
    if type(a)=="number" and type(b)=="number" then return a,b end
    if typeof(a)=="Vector2" then return a.X,a.Y end
    if type(a)=="string" then
        local q,r=a:match("H?(%d+)[_,;:](%d+)")
        if q then return tonumber(q),tonumber(r) end
    end
    if type(a)=="table" then
        local q=a.q or a.Q or a.x or a.X or a.col or a[1]
        local r=a.r or a.R or a.y or a.Y or a.row or a[2]
        if type(q)=="number" and type(r)=="number" then return q,r end
    end
    return nil,nil
end
local function terrLoad()
    if terrCfg and terrFolder and terrFolder.Parent and #terrHexes>0 then return true end
    if terrLoadAt>0 and os.clock()-terrLoadAt < 12 then return false end
    terrLoadAt=os.clock()
    local rs=game:GetService("ReplicatedStorage")
    local folder=rs:FindFirstChild("FeralTerritory")
    local world=rs:FindFirstChild("FeralWorld")
    local module=world and world:FindFirstChild("TerritoryConfig")
    if not folder or not module then
        terrSetPhase("SEM DADOS", "FeralTerritory/TerritoryConfig ausente")
        return false
    end
    local ok, config=pcall(require,module)
    if not ok or type(config)~="table" or type(config.hexCenter)~="function"
        or type(config.hexAt)~="function" then
        terrSetPhase("CONFIG INCOMPATIVEL", "hexCenter/hexAt indisponiveis")
        return false
    end
    local hexList={}
    local seen={}
    local list=tostring(folder:GetAttribute("Hexes") or "")
    for qs,rs2 in list:gmatch("(%d+),(%d+)") do
        local q,r=tonumber(qs),tonumber(rs2)
        local key="H"..q.."_"..r
        if not seen[key] then
            seen[key]=true
            local safe,a,b=pcall(config.hexCenter,q,r)
            local x,z=terrCoords(a,b)
            if safe and type(x)=="number" and type(z)=="number" then
                local correct,aq,ar=pcall(config.hexAt,x,z)
                local hq,hr=terrHexPair(aq,ar)
                if correct and hq==q and hr==r then
                    local reg=folder:GetAttribute(key.."_reg")
                    hexList[#hexList+1]={
                        id=key,q=q,r=r,x=x,z=z,
                        region=reg and tostring(folder:GetAttribute("Reg"..tostring(reg).."_name") or "Regiao "..reg) or "Neutro",
                        neutral=folder:GetAttribute(key.."_neutral")==true
                    }
                end
            end
        end
    end
    if #hexList < 60 then
        terrSetPhase("MAPA INCOMPLETO", tostring(#hexList).." hexagonos validados")
        return false
    end
    table.sort(hexList,function(a,b) return a.id<b.id end)
    terrFolder,terrCfg,terrHexes=folder,config,hexList
    territoryStatus.ready=true
    territoryStatus.total=#hexList
    local count=0
    for _,h in ipairs(hexList) do if not h.neutral then count+=1 end end
    territoryStatus.capturable=count
    terrLog("Mapa validado: "..#hexList.." hexagonos; "..count.." nao neutros")
    return true
end
local function terrOwnedCount(pack)
    if not terrFolder then return 0 end
    local total=0
    for _,hex in ipairs(terrHexes) do
        if not hex.neutral and terrSamePack(terrFolder:GetAttribute(hex.id.."_owner"),pack) then
            total+=1
        end
    end
    return total
end
local function terrGetGround(x,z)
    -- Amostra diretamente Terrain, mas nao precisa alterar a altura original do mapa.
    local result=workspace:Raycast(Vector3.new(x,1050,z),Vector3.new(0,-1700,0),terrGroundCast)
    if not result or result.Material==Enum.Material.Water or result.Normal.Y<0.63 then return nil end
    return Vector3.new(x,result.Position.Y+3.1,z)
end
local function terrPositions(hex,root)
    local candidates={}
    local radius=75 -- pontos continuam dentro dos 120 studs de captura
    local offsets={{0,0},{radius,0},{-radius,0},{0,radius},{0,-radius},
        {53,53},{-53,53},{53,-53},{-53,-53}}
    for _,o in ipairs(offsets) do
        local x,z=hex.x+o[1],hex.z+o[2]
        local ok,a,b=pcall(terrCfg.hexAt,x,z)
        local q,r=terrHexPair(a,b)
        if ok and q==hex.q and r==hex.r then
            local pos=terrGetGround(x,z)
            if pos then
                candidates[#candidates+1]={pos=pos,score=horizontal(root.Position,pos).Magnitude,
                    delta=math.abs(root.Position.Y-pos.Y)}
            end
        end
    end
    table.sort(candidates,function(a,b)
        -- Preferir rota curta sem saltos de altura, que a navegacao avaliara.
        return a.score+math.min(a.delta,100)*1.25 < b.score+math.min(b.delta,100)*1.25
    end)
    return candidates
end
local function terrInterrupt(epoch,char,hum)
    if not active or not CONFIG.AutoTerritory or controlsEpoch~=epoch
        or player.Character~=char or not hum.Parent or hum.Health<=0 then return "CANCELADO" end
    if hum.MaxHealth>0 and (hum.Health/hum.MaxHealth*100)<CONFIG.TerritoryVisitHealthMin then
        return "VIDA BAIXA"
    end
    local h,t=getHunger(),getThirst()
    if CONFIG._drinkActive() and t and t<=CONFIG.DrinkStart then return "PRECISA BEBER" end
    if CONFIG.AutoGrass and h and h<=CONFIG.GrassStart then return "PRECISA PASTAR" end
    if CONFIG._foodActive() and h and h<=CONFIG.HungerStart then return "PRECISA COMER" end
    if h and h<=35 and not CONFIG._foodActive() and not CONFIG.AutoGrass then
        return "FOME CRITICA SEM AUTO DIETA"
    end
    if t and t<=25 and not CONFIG._drinkActive() then return "SEDE CRITICA SEM AUTO DRINK" end
    -- A rotina principal verifica tambem guarda de descanso/morte a cada retorno.
    return nil
end
local function terrSelect(root,pack)
    local best,bestDist=nil,math.huge
    local now=os.clock()
    local pending=0
    for _,hex in ipairs(terrHexes) do
        if not hex.neutral and not terrSamePack(terrFolder:GetAttribute(hex.id.."_owner"),pack) then
            pending+=1
            if (terrCooldowns[hex.id] or 0)<=now then
                local dist=horizontal(root.Position,Vector3.new(hex.x,root.Position.Y,hex.z)).Magnitude
                if dist<bestDist then best,bestDist=hex,dist end
            end
        end
    end
    return best,pending
end
local function terrMoveTo(hex,point,epoch,char,hum,root)
    terrSetPhase("INDO AO HEX",hex.id.." | "..hex.region)
    local getDistance=startMovement(hum,root,function() return point end,
        function() return CONFIG.TerritoryArrivalRadius end,
        function(dist) return dist>70 and 42 or 23 end,true)
    local started=os.clock()
    local lastProgress=started
    local closest=math.huge
    while active and CONFIG.AutoTerritory and controlsEpoch==epoch
        and player.Character==char and root.Parent
        and os.clock()-started < CONFIG.TerritoryTravelTimeout do
        task.wait(0.4)
        if terrSamePack(terrFolder:GetAttribute(hex.id.."_owner"),terrPack()) then
            stopMovement()
            return true,"DOMINADO NO CAMINHO"
        end
        local why=terrInterrupt(epoch,char,hum)
        if why then stopMovement();return false,why end
        local dist,reached,failed=getDistance()
        if reached or dist<=CONFIG.TerritoryArrivalRadius then
            stopMovement()
            return true,"CHEGOU"
        end
        if type(dist)=="number" and dist<closest-2 then
            closest=dist;lastProgress=os.clock()
        end
        if failed or (os.clock()-lastProgress > 24 and os.clock()-started>24) then
            stopMovement()
            return false,"SEM PROGRESSO NA ROTA"
        end
    end
    stopMovement()
    return false,"TIMEOUT DE ROTA"
end
territoryStep=function()
    territoryStatus.enabled=CONFIG.AutoTerritory
    if not CONFIG.AutoTerritory then return end
    if not terrLoad() then task.wait(3);return end
    local pack=terrPack()
    territoryStatus.pack=pack
    if not pack then
        territoryStatus.current=nil
        territoryStatus.progress=0
        terrSetPhase("CRIAR GRUPO", "Crie ou entre em um pack antes de ativar")
        task.wait(2)
        return
    end
    if terrLastPack~=pack then
        terrLastPack=pack
        table.clear(terrCooldowns)
    end
    territoryStatus.owned=terrOwnedCount(pack)
    local char,hum,root=actor()
    if not char or hum.Health<=0 then terrSetPhase("SEM ANIMAL");task.wait(1);return end
    local epoch=controlsEpoch
    local why=terrInterrupt(epoch,char,hum)
    if why then terrSetPhase("PAUSA DE SEGURANCA",why);task.wait(2);return end
    local hex,pending=terrSelect(root,pack)
    if not hex then
        territoryStatus.current=nil
        territoryStatus.progress=0
        if pending==0 then
            terrSetPhase("SEM PENDENTES", "Todos os hexagonos capturaveis desta sessao pertencem ao pack")
        else
            terrSetPhase("AGUARDANDO ROTAS", "Areas pendentes em cooldown: "..pending)
        end
        task.wait(4)
        return
    end
    territoryStatus.current=hex.id
    territoryStatus.region=hex.region
    territoryStatus.progress=tonumber(terrFolder:GetAttribute(hex.id.."_prog")) or 0
    local spots=terrPositions(hex,root)
    if #spots==0 then
        territoryStatus.failures+=1
        terrCooldowns[hex.id]=os.clock()+CONFIG.TerritoryRetrySeconds
        terrSetPhase("SEM SOLO SEGURO",hex.id.." | tentando outro depois")
        task.wait(0.5)
        return
    end
    local entered=false
    for i=1,math.min(#spots,CONFIG.TerritoryMaxCandidatePoints) do
        if terrInterrupt(epoch,char,hum) then return end
        local reached,reason=terrMoveTo(hex,spots[i].pos,epoch,char,hum,root)
        if terrSamePack(terrFolder:GetAttribute(hex.id.."_owner"),pack) then
            entered=true
            break
        end
        if reached then
            entered=true
            break
        end
        terrLog(hex.id.." | ponto "..i.." falhou: "..reason)
        if reason=="CANCELADO" or reason=="VIDA BAIXA" or reason=="PRECISA BEBER"
            or reason=="PRECISA COMER" or reason=="PRECISA PASTAR" then return end
        if i>=2 then break end -- nao gastar minutos tentando todos os pontos numa area bloqueada
    end
    if not entered then
        territoryStatus.failures+=1
        terrCooldowns[hex.id]=os.clock()+CONFIG.TerritoryRetrySeconds
        terrSetPhase("ROTA BLOQUEADA",hex.id)
        return
    end
    terrSetPhase("CAPTURANDO",hex.id.." | "..hex.region)
    local claimStart=os.clock()
    local lastChange=claimStart
    local lastProgress=tonumber(terrFolder:GetAttribute(hex.id.."_prog")) or 0
    local signalSeen=lastProgress>0
    while active and CONFIG.AutoTerritory and controlsEpoch==epoch
        and player.Character==char and root.Parent and os.clock()-claimStart<CONFIG.TerritoryTimeout do
        task.wait(.65)
        if terrSamePack(terrFolder:GetAttribute(hex.id.."_owner"),pack) then
            territoryStatus.successes+=1
            territoryStatus.owned=terrOwnedCount(pack)
            territoryStatus.progress=1
            territoryStatus.lastResult="DOMINADO: "..hex.id
            terrLog("CAPTURA CONFIRMADA "..hex.id.." | "..territoryStatus.owned.."/"..territoryStatus.capturable)
            terrSetPhase("CONQUISTADO",hex.id)
            task.wait(1.5)
            return
        end
        local interrupt=terrInterrupt(epoch,char,hum)
        if interrupt then terrSetPhase("PAUSADO",interrupt);return end
        local progress=tonumber(terrFolder:GetAttribute(hex.id.."_prog")) or 0
        territoryStatus.progress=math.clamp(progress,0,1)
        if math.abs(progress-lastProgress)>0.002 then
            signalSeen=true
            lastChange=os.clock()
            lastProgress=progress
        end
        local distance=horizontal(root.Position,Vector3.new(hex.x,root.Position.Y,hex.z)).Magnitude
        if distance>CONFIG.TerritoryClaimRadius-8 then
            terrSetPhase("SAIU DO HEX",hex.id.." | distancia "..math.floor(distance))
            break
        end
        if os.clock()-lastChange > CONFIG.TerritoryProgressTimeout then
            if not signalSeen then
                terrSetPhase("SEM CAPTURA",hex.id.." | pack ativo? area disputada?")
            else
                terrSetPhase("PROGRESSO PARADO",hex.id.." | prog "..math.floor(progress*100).."%")
            end
            break
        end
    end
    if not CONFIG.AutoTerritory or controlsEpoch~=epoch then return end
    territoryStatus.failures+=1
    terrCooldowns[hex.id]=os.clock()+CONFIG.TerritoryRetrySeconds
    territoryStatus.lastResult="PENDENTE: "..hex.id
    terrLog(hex.id.." ainda nao dominado; tentar outra regiao")
end

