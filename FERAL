end

-- === AUTO QUEST V8.9.34 ===
-- O jogo controla a lista de quests e os progressos. Este bloco so le a GUI.
-- A GUI mostra 3 quests por aba; guardamos as ultimas quests vistas de cada aba.
-- Coordenadas de Alder Creek, Beaver Ponds e Elk Crossing foram verificadas no jogo.
local questSeen = {}
local questLastSignature = nil
local questDoneAnnounced = {}
local lastQuestWarning = 0
local questLastLogged = {}

local function questClean(value)
    return tostring(value or ""):gsub("[%c]", " "):gsub("^%s+", ""):gsub("%s+$", "")
end

local function questIsText(obj)
    return obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")
end

local function questList()
    local gui = player:FindFirstChild("PlayerGui")
    local screen = gui and gui:FindFirstChild("FeralQuests")
    local frame = screen and screen:FindFirstChild("Frame")
    local root = frame and frame:FindFirstChild("Root")
    local quests = root and root:FindFirstChild("Quests")
    local panel = quests and quests:FindFirstChild("Panel")
    return panel and panel:FindFirstChild("List")
end

local function questTitle(quest)
    local card = quest:FindFirstChild("Card")
    local title = card and card:FindFirstChild("TextLabel")
    if title and questIsText(title) and questClean(title.Text) ~= "" then
        return questClean(title.Text)
    end
    for _, obj in ipairs(quest:GetDescendants()) do
        if questIsText(obj) and questClean(obj.Text) ~= "" then
            return questClean(obj.Text)
        end
    end
    return nil
end

local function questProgress(quest)
    local card = quest:FindFirstChild("Card")
    local bar = card and card:FindFirstChild("Bar")
    local parts = {}
    if bar then
        for _, obj in ipairs(bar:GetDescendants()) do
            if questIsText(obj) then
                local v = questClean(obj.Text)
                if v ~= "" then table.insert(parts, v) end
            end
        end
    end
    return table.concat(parts, " | ")
end

local function questCategory(name)
    local t = string.lower(name)
    -- QuestConfig.QUICK: id=catchMice, kind=hunt, title="Catch a mouse".
    -- Ela nao comeca com Hunt/Kill, por isso precisava de categoria propria.
    if t:find("catch a mouse", 1, true)
        or t:find("catch mice", 1, true)
        or t:find("catch mouse", 1, true) then
        return "CACA"
    end
    if t:find("graze", 1, true) or t:find("grazing", 1, true)
        or t:find("grass patch", 1, true) or t:find("grass patches", 1, true) then
        return "PASTO"
    end
    -- Prioriza verbos completos e evita "eat" dentro de "Great".
    -- Ex.: Drink at Great Falls deve ser AGUA, nao COMIDA.
    -- Tambem evita classificar Go to Golden Waterhole como AGUA por causa de Waterhole.
    local words = " " .. t:gsub("[^%w]+", " ") .. " "
    if words:find(" drink ", 1, true) or words:find(" water ", 1, true)
        or words:find(" beber ", 1, true) then
        return "AGUA"
    end
    if words:find(" eat ", 1, true) or words:find(" meat ", 1, true)
        or words:find(" comer ", 1, true) then
        return "COMIDA"
    end
    if t:find("hunt", 1, true) or t:find("kill", 1, true) or t:find("cacar", 1, true) then
        return "CACA"
    end
    if t:find("travel", 1, true) or t:find("distance", 1, true) then
        return "DISTANCIA"
    end
    if t:find("rest for", 1, true) or t:find("rest ", 1, true) then
        return "DESCANSO"
    end
    if t:find("claim a territory", 1, true) or t:find("claim territory", 1, true) then
        return "TERRITORIO"
    end
    if t:find("explore", 1, true) or t:find("visit", 1, true) or t:find("go to", 1, true) then
        return "LOCAL"
    end
    return "OUTRA"
end

local function questIsDone(progress)
    local u = string.upper(progress or "")
    if u:find("DONE", 1, true) or u:find("COMPLETE", 1, true) then
        return true
    end
    local a, b = u:match("(%d+)%s*/%s*(%d+)")
    return a ~= nil and b ~= nil and tonumber(b) > 0 and tonumber(a) >= tonumber(b)
end

-- V8.9.34: a lista pode ter wrappers adicionais ou mudar de lugar na GUI.
-- Procura os cards de quest de forma limitada e reutiliza o parser original.
local questScanSource = "INICIANDO"
local questScanAt = 0
local questScanCount = 0
local function questCardsForScan()
    local gui = player:FindFirstChild("PlayerGui")
    local list = questList()
    local cards = {}
    local seen = {}
    local function collect(parent)
        if not parent then return end
        local function tryAdd(obj)
            if obj.Name == "Quest" and obj:FindFirstChild("Card")
                and not seen[obj] then
                seen[obj] = true
                table.insert(cards, obj)
            end
        end
        for _, child in ipairs(parent:GetChildren()) do tryAdd(child) end
        if #cards == 0 then
            for _, child in ipairs(parent:GetDescendants()) do tryAdd(child) end
        end
    end
    collect(list)
    if #cards > 0 then return cards, "LISTA ORIGINAL" end
    local screen = gui and gui:FindFirstChild("FeralQuests")
    if screen and screen ~= list then collect(screen) end
    if #cards > 0 then return cards, "GUI FERALQUESTS" end
    if gui then collect(gui) end
    return cards, #cards > 0 and "PLAYERGUI FALLBACK" or "SEM CARDS"
end

-- Fallback estrito: identifica textos de missao de bebida visiveis e tenta
-- ler progresso no mesmo cartao, caso o jogo nao crie cards chamados 'Quest'.
local function questNamedDrinkFromVisibleGUI()
    local gui = player:FindFirstChild("PlayerGui")
    if not gui then return {} end
    local results, seen = {}, {}
    local allowedPlaces = {"alder creek", "beaver ponds", "dead lagoon",
        "great falls", "granite basin", "golden waterhole", "elk crossing"}
    local function visible(obj)
        local node = obj
        while node and node ~= gui do
            if node:IsA("ScreenGui") and not node.Enabled then return false end
            if node:IsA("GuiObject") and not node.Visible then return false end
            node = node.Parent
        end
        return true
    end
    for _,obj in ipairs(gui:GetDescendants()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and visible(obj) then
            local label = questClean(obj.Text)
            local low = label:lower()
            if low:find("drink at ", 1, true) == 1 and not seen[label] then
                local supported = false
                for _,place in ipairs(allowedPlaces) do
                    if low:find("drink at " .. place, 1, true) == 1 then
                        supported = true
                        break
                    end
                end
                if supported then
                    local progress = nil
                    local ancestor = obj.Parent
                    for depth=1,3 do
                        if not ancestor or ancestor == gui then break end
                        local rowTitleCount = 0
                        local foundProgress = nil
                        for _,child in ipairs(ancestor:GetDescendants()) do
                            if child:IsA("TextLabel") or child:IsA("TextButton") then
                                local t = questClean(child.Text)
                                if t:lower():find("drink at ",1,true)==1 then
                                    rowTitleCount += 1
                                end
                                if t:match("%d+%s*/%s*%d+") or t:upper() == "DONE" then
                                    foundProgress = t
                                end
                            end
                        end
                        if rowTitleCount == 1 and foundProgress then
                            progress = foundProgress
                            break
                        end
                        ancestor = ancestor.Parent
                    end
                    if progress then
                        seen[label] = true
                        table.insert(results, {name=label,progress=progress})
                    end
                end
            end
        end
    end
    return results
end

local function questScan()
    local cards, source = questCardsForScan()
    local fallback = questNamedDrinkFromVisibleGUI()
    questScanSource = source
    questScanAt = os.clock()
    questScanCount = #cards + #fallback
    if questScanCount == 0 then
        if os.clock() - lastQuestWarning > 25 then
            warn("AUTO QUEST: nao encontrou cards na GUI; abra QUICK/DAILY uma vez")
            lastQuestWarning = os.clock()
        end
        return
    end
    local signature = {}
    local count = 0
    local newlyDetected = 0
    -- Usa o mesmo processamento de quest anterior para manter todas as regras.
    local entries = {}
    for _,card in ipairs(cards) do
        local name = questTitle(card)
        if name and name ~= "" then
            table.insert(entries,{name=name,progress=questProgress(card)})
        end
    end
    for _,entry in ipairs(fallback) do
        local duplicate = false
        for _,existing in ipairs(entries) do
            if existing.name == entry.name then duplicate = true; break end
        end
        if not duplicate then table.insert(entries,entry) end
    end
    for _,entry in ipairs(entries) do
        local name,progress = entry.name,entry.progress
        if name and name ~= "" then
                local old = questSeen[name]
                if not old then newlyDetected += 1 end
                local done = questIsDone(progress)
                questSeen[name] = {
                    title = name, progress = progress, category = questCategory(name),
                    done = done, lastSeen = os.clock()
                }
                count += 1
                table.insert(signature, name)
                if not old or old.progress ~= progress or old.done ~= done then
                    -- Limita spam de progresso. Nunca omite nova quest ou a primeira transicao para DONE.
                    local previous = questLastLogged[name]
                    local now = os.clock()
                    if not previous or previous.done ~= done or now - previous.time >= 8 then
                        questLastLogged[name] = {done = done, time = now}
                        print("AUTO QUEST:", name, "|", progress ~= "" and progress or "sem progresso", done and "[DONE]" or "[PENDENTE]")
                    end
                end
                if old and old.done and not done then
                    -- Uma nova rodada de quests pode reutilizar o titulo anterior.
                    questDoneAnnounced[name] = nil
                end
                if done and not questDoneAnnounced[name] then
                    questDoneAnnounced[name] = true
                    print("AUTO QUEST CONCLUIDA:", name)
                end
            end
        end
    table.sort(signature)
    local sig = table.concat(signature, " || ")
    -- Usa o mesmo prazo da consulta para liberar registros realmente vencidos.
    local now = os.clock()
    for title, quest in pairs(questSeen) do
        if now - quest.lastSeen > CONFIG.QuestCacheSeconds then
            questSeen[title] = nil
            questLastLogged[title] = nil
            questDoneAnnounced[title] = nil
        end
    end
    for npc, deadline in pairs(failedUntil) do
        if deadline <= now or not npc.Parent then failedUntil[npc] = nil end
    end
    if count > 0 then
        -- QUICK e DAILY alternam a lista visivel, mas nao geram spam no console.
        questLastSignature = sig
        if newlyDetected > 0 then
            print("AUTO QUEST:", newlyDetected, "nova(s) quest(s) registrada(s)")
        end
    end
end

local function currentQuests()
    local results = {}
    local now = os.clock()
    for _, q in pairs(questSeen) do
        if now - q.lastSeen <= CONFIG.QuestCacheSeconds then
            table.insert(results, q)
        end
    end
    table.sort(results, function(a, b) return a.title < b.title end)
    return results
end

-- Se as abas forem trocadas rapidamente, o scanner periodico de 2.5 s pode
-- perder uma delas. Encontra os botoes reais QUICK/DAILY e escaneia apos clique.
local questTabConnections = {}
local questTabScreen = nil
local questQuickButton, questDailyButton = nil, nil
stopQuestTabHooks = function()
    for _, connection in pairs(questTabConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(questTabConnections)
    questTabScreen = nil
    questQuickButton, questDailyButton = nil, nil
end
local function questTabButtons()
    local gui = player:FindFirstChild("PlayerGui")
    local screen = gui and gui:FindFirstChild("FeralQuests")
    if screen ~= questTabScreen then
        stopQuestTabHooks()
        questTabScreen = screen
    end
    if not screen then return nil, nil end
    -- Libera botoes removidos mesmo quando a tela principal continua existindo.
    for button, connection in pairs(questTabConnections) do
        if not button:IsDescendantOf(screen) then
            connection:Disconnect()
            questTabConnections[button] = nil
        end
    end
    if questQuickButton and questQuickButton:IsDescendantOf(screen)
        and questDailyButton and questDailyButton:IsDescendantOf(screen) then
        return questQuickButton, questDailyButton
    end
    local quick, daily
    for _, obj in ipairs(screen:GetDescendants()) do
        if obj:IsA("GuiButton") then
            local name = string.lower(obj.Name)
            if obj:IsA("TextButton") then
                name ..= " " .. string.lower(obj.Text)
            end
            -- Alguns jogos colocam o titulo num TextLabel dentro do botao.
            local label = obj:FindFirstChildWhichIsA("TextLabel", true)
            if label then name ..= " " .. string.lower(label.Text) end
            if not quick and name:find("quick", 1, true) then quick = obj end
            if not daily and name:find("daily", 1, true) then daily = obj end
        end
    end
    questQuickButton, questDailyButton = quick, daily
    return quick, daily
end

local function bindQuestTab(button)
    if not button or questTabConnections[button] then return end
    local screen = questTabScreen
    local conn = button.Activated:Connect(function()
        -- Aguarda o jogo trocar a lista e salva exatamente o progresso visivel.
        task.delay(0.35, function()
            if active and CONFIG.AutoQuest and screen == questTabScreen
                and button:IsDescendantOf(screen) then pcall(questScan) end
        end)
    end)
    questTabConnections[button] = conn
end

local function installQuestTabHooks()
    local quick, daily = questTabButtons()
    bindQuestTab(quick)
    bindQuestTab(daily)
    return quick, daily
end

local function amberReady(requireFullHealth)
    if not CONFIG.GetAmber then return false, "DESATIVADO" end
    if CONFIG.AutoGrass then
        local herb = herbivoreState()
        if herb == true then return false, "PAUSADO: AUTO GRASS" end
    end
    if os.clock() < amberPauseUntil then return false, "PAUSA DE SEGURANCA" end
    local _, hum = actor()
    if not hum or hum.MaxHealth <= 0 or hum.Health <= 0 then
        return false, "VIDA INDISPONIVEL"
    end
    local hp = hum.Health / hum.MaxHealth * 100
    if hp < (requireFullHealth and CONFIG.AmberStartHealthPercent or CONFIG.AmberAbortHealthPercent) then
        return false, "VIDA BAIXA"
    end
    local h, t = getHunger(), getThirst()
    if not h or h < CONFIG.AmberMinHunger then return false, "COMER PRIMEIRO" end
    if not t or t < CONFIG.AmberMinThirst then return false, "BEBER PRIMEIRO" end
    return true, "PRONTO PARA FARMAR"
end

local function questPending(category, filter)
    if not CONFIG.AutoQuest then return nil end
    for _, q in ipairs(currentQuests()) do
        if not q.done and q.category == category and (not filter or filter(q)) then
            return q
        end
    end
    return nil
end

