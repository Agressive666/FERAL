-- === AUTO RESPAWN V8.9.28 ===
-- No Roblox do FERAL o botao verde RESPAWN eh gratuito.
-- NUNCA clica REVIVE, CHANGE ANIMAL, 2x GROWTH ou qualquer compra.
-- O nome da GUI nao foi identificado, portanto o alvo eh procurado pelo texto
-- EXATO "RESPAWN" e apenas se a morte estiver confirmada.
local respawnState = {
    dead=false, since=0, lastClick=0, attempts=0,
    deaths=0, successes=0, lastStatus="INICIANDO", lastButton="nenhum"
}

local function respawnVisible(obj)
    if not obj or not obj.Parent then return false end
    local at=obj
    while at and at~=player do
        if at:IsA("ScreenGui") and not at.Enabled then return false end
        if at:IsA("GuiObject") and (not at.Visible or at.AbsoluteSize.X<2 or at.AbsoluteSize.Y<2) then
            return false
        end
        at=at.Parent
    end
    return true
end

local function normalizeRespawnText(value)
    return tostring(value or ""):gsub("<[^>]*>", "")
        :gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", ""):upper()
end

local function locateRespawnUI()
    local pg=player:FindFirstChild("PlayerGui")
    if not pg then return nil,false end
    local deathTitle=false
    local best=nil
    -- Descendants do PlayerGui sao apenas lidos; nao modificamos o UI do jogo.
    for _,obj in ipairs(pg:GetDescendants()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and respawnVisible(obj) then
            local text=normalizeRespawnText(obj.Text)
            if text=="YOU DIED" then deathTitle=true end
            if text=="RESPAWN" then
                local at=obj
                while at and at~=pg do
                    if at:IsA("GuiButton") and respawnVisible(at) then
                        best=at
                        break
                    end
                    at=at.Parent
                end
            end
        end
    end
    return best,deathTitle
end

