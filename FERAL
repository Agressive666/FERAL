-- Detecta a dieta quando o jogo expoe atributos; se nao expoe,
-- so tenta pastar quando o usuario habilitar Auto Grass e houver prompt EAT/GRAZE.
local function herbivoreState()
    local char = player.Character
    if not char then return nil, "SEM PERSONAGEM" end
    local values = {}
    for _, inst in ipairs({char, player}) do
        for _, key in ipairs({"Diet", "AnimalDiet", "FoodType", "Species", "SpeciesName", "Animal", "AnimalName", "AnimalType"}) do
            local v = inst:GetAttribute(key)
            if type(v) == "string" and v ~= "" then
                if key == "Diet" or key == "AnimalDiet" or key == "FoodType" then
                    local d = v:lower()
                    if d:find("herbi", 1, true) then return true, v end
                    if d:find("carni", 1, true) then return false, v end
                end
                table.insert(values, v)
            end
        end
    end
    -- Nome do avatar e fallback, nao deve superar o atributo real Species.
    table.insert(values, char.Name)
    local herbi = {"deer", "elk", "bison", "rhino", "porcupine", "elephant", "hippo", "hippopotamus", "goat", "moose", "antelope", "gazelle", "giraffe", "zebra", "horse", "rabbit", "hare"}
    local others = {"wolf", "tiger", "otter", "fox", "bear", "cougar", "python", "cobra", "alligator", "crocodile", "eagle", "lion", "leopard"}
    for _, value in ipairs(values) do
        local normalized = tostring(value):lower():gsub("[^%a]", "")
        for _, name in ipairs(herbi) do
            if normalized:find(name, 1, true) then return true, value end
        end
        for _, name in ipairs(others) do
            if normalized:find(name, 1, true) then return false, value end
        end
    end
    return nil, "DIETA NAO IDENTIFICADA"
end

