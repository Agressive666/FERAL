-- === AUTO DRINK V8.9.28: MARGEM SEGURA, NAO VOXEL DE AGUA ===
-- Escolhe solo seco ao lado da agua e recusa lago abaixo de barranco.
-- Nao reduz a protecao anti-queda nem altera o Terrain.
local failedWater = {}
local lastUnsafeWaterWarning = 0

local function waterIsBlocked(p)
    local now=os.clock()
    for i=#failedWater,1,-1 do
        local rec=failedWater[i]
        if rec.untilTime<=now then
            table.remove(failedWater,i)
        elseif horizontal(rec.pos,p).Magnitude<CONFIG.WaterFailedRadius then
            return true
        end
    end
    return false
end

local function blockWater(p)
    if typeof(p)~="Vector3" then return end
    table.insert(failedWater, {pos=p,untilTime=os.clock()+CONFIG.WaterFailedCooldown})
    if #failedWater>24 then table.remove(failedWater,1) end
    print("AUTO DRINK MARGEM: fonte em espera por",CONFIG.WaterFailedCooldown,"s |",tostring(p))
end

local waterLandRay = RaycastParams.new()
waterLandRay.FilterType = Enum.RaycastFilterType.Include
waterLandRay.FilterDescendantsInstances = {Terrain}
waterLandRay.IgnoreWater = true

-- Converte uma coordenada DE AGUA para uma posicao SECA na margem.
-- O codigo antigo usava a posicao da agua (Y=190) mesmo com o lobo em Y=217.
local function findAccessibleBank(waterPos, fromPos)
    if typeof(waterPos)~="Vector3" or waterIsBlocked(waterPos) then return nil end
    local currentDist=horizontal(fromPos,waterPos).Magnitude
    local heightDelta=fromPos.Y-waterPos.Y
    local maxDrop=currentDist<260 and CONFIG.WaterBankMaxNearbyDrop
        or CONFIG.WaterBankMaxFarDrop
    if heightDelta>maxDrop+6 or heightDelta< -22 then
        if os.clock()-lastUnsafeWaterWarning>8 then
            lastUnsafeWaterWarning=os.clock()
            warn("AUTO DRINK MARGEM: agua ignorada, desnivel alto:",
                math.floor(heightDelta),"studs | agua:",tostring(waterPos))
        end
        return nil
    end

    local bestBank,bestScore=nil,math.huge
    for _, radius in ipairs({4,6,9,12,14}) do
        if radius>CONFIG.WaterBankSearchRadius then break end
        for i=0,11 do
            local angle=2*math.pi*i/12
            local x=waterPos.X+math.cos(angle)*radius
            local z=waterPos.Z+math.sin(angle)*radius
            local hit=workspace:Raycast(
                Vector3.new(x,waterPos.Y+46,z),Vector3.new(0,-100,0),waterLandRay)
            if hit and hit.Material~=Enum.Material.Water and hit.Normal.Y>=0.72 then
                local difference=hit.Position.Y-waterPos.Y
                -- Margem tem altitude parecida com a agua, nao o topo de um paredao.
                if difference>=-2.0 and difference<=6.0 then
                    local bank=Vector3.new(x,hit.Position.Y+2.5,z)
                    local remainingDrop=fromPos.Y-bank.Y
                    if remainingDrop<=maxDrop and remainingDrop>=-22 then
                        local distance=horizontal(fromPos,bank).Magnitude
                        local score=distance + radius*3.0 + math.abs(difference)*2.5
                        if score<bestScore then
                            bestBank,bestScore=bank,score
                        end
                    end
                end
            end
        end
    end
    return bestBank
end

-- Busca agua dentro de um pequeno bloco (em voxels), sem carregar o mapa inteiro.
local function scanWaterBlock(center, halfWidth, referencePos)
    local resolution=4
    local region=Region3.new(
        center-Vector3.new(halfWidth,24,halfWidth),
        center+Vector3.new(halfWidth,16,halfWidth)
    ):ExpandToGrid(resolution)
    local ok,materials,occupancy=pcall(function()
        return Terrain:ReadVoxels(region,resolution)
    end)
    if not ok then
        warn("Auto Drink: falha na leitura de agua:",tostring(materials))
        return nil
    end
    local base=region.CFrame.Position-region.Size/2
    local closest,best=nil,math.huge
    for x=1,#materials do
        for y=1,#materials[x] do
            for z=1,#materials[x][y] do
                if materials[x][y][z]==Enum.Material.Water
                    and occupancy[x][y][z]>0 then
                    local p=base+Vector3.new(
                        (x-0.5)*resolution,
                        (y-0.5)*resolution,
                        (z-0.5)*resolution)
                    local vertical=referencePos.Y-p.Y
                    local distance=horizontal(referencePos,p).Magnitude
                    if vertical>=-10 and vertical<=90
                        and distance<=CONFIG.WaterSearchRadius
                        and distance<best and not waterIsBlocked(p) then
                        closest,best=p,distance
                    end
                end
            end
        end
    end
    return closest,best
end

local function findLocalWater(pos)
    return scanWaterBlock(pos,CONFIG.WaterLocalRadius,pos)
end

local function findWater()
    if not CONFIG.AutoDrink then return nil end
    local scanEpoch=controlsEpoch
    local _,_,root=actor()
    if not root then return nil end
    local origin=root.Position

    local nearby=findLocalWater(origin)
    if nearby then
        local bank=findAccessibleBank(nearby,origin)
        if bank then
            return bank,"Margem Terrain local",horizontal(origin,bank).Magnitude,nearby
        end
    end

    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances={Terrain}
    params.IgnoreWater=false

    local rings={90,175,260,350,460,580,720,870,1040,1240,1460,1700,1960,2240,2540,2840,3000}
    local started=os.clock()
    local checks=0
    print("AUTO DRINK MARGEM: procurando margem seca, acessivel e proxima da agua...")
    for _,ring in ipairs(rings) do
        if not active or not CONFIG.AutoDrink or scanEpoch~=controlsEpoch then return nil end
        if ring>CONFIG.WaterSearchRadius+45 then break end
        local spacing=(ring<=580) and 58 or ((ring<=1240) and 90 or 130)
        local count=math.max(10,math.ceil((2*math.pi*ring)/spacing))
        local bestBank,bestWater,bestDist=nil,nil,math.huge
        for i=0,count-1 do
            if not active or not CONFIG.AutoDrink or scanEpoch~=controlsEpoch then return nil end
            if os.clock()-started>CONFIG.WaterScanTimeBudget then
                warn("AUTO DRINK MARGEM: tempo limite do scan; ultimo anel:",ring)
                return nil
            end
            local angle=2*math.pi*i/count
            local x=origin.X+math.cos(angle)*ring
            local z=origin.Z+math.sin(angle)*ring
            local result=workspace:Raycast(
                Vector3.new(x,origin.Y+350,z),Vector3.new(0,-900,0),params)
            local water=nil
            if result and result.Material==Enum.Material.Water then
                local p=result.Position
                if origin.Y-p.Y>=-10 and origin.Y-p.Y<=90 and not waterIsBlocked(p) then
                    water=p
                end
            end
            if not water and ring<=720 then
                local y=result and result.Position.Y or origin.Y
                water=scanWaterBlock(Vector3.new(x,y,z),ring<=350 and 38 or 48,origin)
            end
            if water then
                local bank=findAccessibleBank(water,origin)
                if bank then
                    local dist=horizontal(origin,bank).Magnitude
                    if dist<bestDist and dist<=CONFIG.WaterSearchRadius then
                        bestBank,bestWater,bestDist=bank,water,dist
                    end
                end
            end
            checks+=1
            if checks%8==0 then task.wait() end
        end
        if bestBank then
            print("AUTO DRINK MARGEM: encontrada em",math.floor(bestDist),
                "studs | altura:",math.floor(bestBank.Y),"| anel",ring)
            return bestBank,"Margem Terrain dinamico",bestDist,bestWater
        end
    end
    warn("AUTO DRINK MARGEM: sem margem acessivel; nao vou pular de barrancos")
    return nil
end

-- Evita repetir o mesmo scan enquanto o animal continua no mesmo barranco.
local failedScanPosition, failedScanCharacter, failedScanUntil
local function drinkOnce()
    if not CONFIG.AutoDrink then return end
    local actionEpoch = controlsEpoch
    if os.clock() < nextDrinkTry then return end
    local scanCharacter, _, scanRoot = actor()
    if not scanRoot then return end
    local scanPosition = scanRoot.Position
    if failedScanPosition and failedScanCharacter == scanCharacter
        and os.clock() < failedScanUntil
        and horizontal(scanPosition, failedScanPosition).Magnitude < 20
        and math.abs(scanPosition.Y - failedScanPosition.Y) < 6 then
        nextDrinkTry = math.min(failedScanUntil, os.clock() + 1)
        return
    end
    failedScanPosition, failedScanCharacter, failedScanUntil = nil, nil, nil
    nextDrinkTry = os.clock() + 8
    print("AUTO DRINK: iniciando busca | Sede:", tostring(getThirst()))

    local target, source, initialDistance, sourceWater = findWater()
    if not CONFIG.AutoDrink or controlsEpoch ~= actionEpoch then return end
    if not target then
        failedScanPosition, failedScanCharacter = scanPosition, scanCharacter
        failedScanUntil = os.clock() + 45
        nextDrinkTry = os.clock() + 1
        print("Auto Drink: sem margem acessivel; nova busca ao mudar de posicao ou em 45 s")
        return
    end

    local char, hum, root = actor()
    if not char then return end
    print("AUTO DRINK MARGEM: DESTINO SECO:", tostring(target), "| Origem:", source,
        "| Distancia:", math.floor(initialDistance), "| agua:", tostring(sourceWater))

    local getDistance = startMovement(hum, root, function()
        return target
    end, function()
        if math.abs(root.Position.Y - target.Y) > 11 then
            return 0.5
        end
        return CONFIG.WaterStopDistance
    end, function(dist)
        if dist > 45 then
            return CONFIG.WaterCruiseSpeed
        elseif dist > 15 then
            return CONFIG.WaterMoveSpeed
        end
        return 7
    end, true)

    local started = os.clock()
    local lastBest = initialDistance
    local lastAdvance = started
    local lastWaterScan = started
    local lastLog = 0
    local arrived = false
    local timeout = math.min(CONFIG.WaterTravelTimeout,
        math.max(35, initialDistance / 8 + 25))

    while active and CONFIG.AutoDrink and controlsEpoch == actionEpoch
        and player.Character == char and os.clock() - started < timeout do
        task.wait(0.25)
        if not root.Parent then break end
        local d, reached, navFailed, navMode = getDistance()
        if navFailed and navMode ~= "RESGATE_AGUA" then
            warn("AUTO DRINK MARGEM: navegacao sem rota segura; tentando outra fonte")
            break
        end
        if reached then
            arrived = true
            break
        end
        if d < lastBest - 0.5 then
            lastBest = d
            lastAdvance = os.clock()
        end
        if os.clock() - lastAdvance > CONFIG.StuckTimeout then
            warn("Auto Drink: sem progresso no caminho")
            break
        end
        if os.clock() - lastLog > 5 then
            print("Auto Drink: indo ate a agua | faltam", math.floor(d), "studs")
            lastLog = os.clock()
        end
        if getThirst() and getThirst() >= CONFIG.DrinkStop then break end

        -- Atualiza SOMENTE para outra margem seca bem mais proxima.
        -- Nao muda o destino para voxels de agua, evitando o loop perto do barranco.
        if d <= 65 and os.clock() - lastWaterScan >= 8 then
            lastWaterScan=os.clock()
            local water=findLocalWater(root.Position)
            local newBank=water and findAccessibleBank(water,root.Position) or nil
            if newBank then
                local newDist=horizontal(root.Position,newBank).Magnitude
                local oldDist=horizontal(root.Position,target).Magnitude
                if oldDist-newDist >= 12 and horizontal(target,newBank).Magnitude<=45 then
                    target=newBank
                    sourceWater=water
                    lastBest=newDist
                    lastAdvance=os.clock()
                    print("AUTO DRINK MARGEM: margem seca alternativa:",tostring(target))
                end
            end
        end
    end
    stopMovement()

    if not active or not CONFIG.AutoDrink or controlsEpoch ~= actionEpoch then return end
    if not arrived then
        warn("AUTO DRINK MARGEM: nao alcancou solo seguro; fonte bloqueada temporariamente")
        blockWater(sourceWater or target)
        return
    end
    print("AUTO DRINK MARGEM: solo seguro alcancado; tentando Feed drink")

    local state = promptState()
    if windowFocused and (state == "EAT" or state == "EATING") then
        print("Auto Drink: prompt EAT ativo; nao pressionou E")
        blockWater(sourceWater or target)
        return
    end

    local before = getThirst()
    local lastThirst = before or 0
    local lastGain = os.clock()
    local lastPress = 0
    local attempts = 0
    local hydrationConfirmed = false
    local maxDrinkTime = os.clock() + 55
    while active and CONFIG.AutoDrink and controlsEpoch == actionEpoch
        and root.Parent and player.Character == char and os.clock() < maxDrinkTime do
        local now = getThirst()
        if not now then break end
        if now >= CONFIG.DrinkStop then
            print("Auto Drink: SEDE RECUPERADA:", math.floor(now), "%")
            nextDrinkTry = 0
            return
        end
        if now > lastThirst + 0.05 then
            lastGain = os.clock()
            if not hydrationConfirmed then
                print("Auto Drink: BEBENDO CONFIRMADO")
                hydrationConfirmed = true
            end
        end
        lastThirst = now
        -- So aperta E novamente quando a sede ficou parada; evita cancelar o ato de beber.
        local needsPress = attempts == 0 or (os.clock() - lastGain > 4 and os.clock() - lastPress > 4)
        if needsPress and attempts < 5 then
            attempts += 1
            lastPress = os.clock()
            local ok, method=feedInteraction("drink")
            if ok then
                print("Auto Drink: Feed drink via",method,"| tentativa",attempts,
                    "| sede",math.floor(now))
            else
                warn("Auto Drink: falha ao enviar Feed drink")
                break
            end
        end
        if os.clock() - lastGain > 13 and attempts >= 3 then break end
        task.wait(0.8)
    end
    if not CONFIG.AutoDrink or controlsEpoch ~= actionEpoch then return end
    if hydrationConfirmed then
        print("Auto Drink: a sede subiu, mas nao chegou a", CONFIG.DrinkStop, "%")
        nextDrinkTry = os.clock() + 2
    else
        warn("Auto Drink: agua localizada, mas Feed drink nao confirmou hidratacao")
        blockWater(sourceWater or target)
        nextDrinkTry = os.clock() + 10
    end
end

