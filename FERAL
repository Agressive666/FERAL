end

-- V8.9.37: prioriza clique real na tela. "firesignal" nao equivale
-- necessariamente a clicar no botao, por isso fica como fallback.
local function requestRespawn(button,attempt)
    if not (button and button:IsA("GuiObject") and respawnVisible(button)) then
        return false,"BOTAO","area de respawn nao visivel"
    end
    if not windowFocused then
        return false,"SEM FOCO","clique aguardando janela Roblox em primeiro plano"
    end
    local mid=button.AbsolutePosition+button.AbsoluteSize/2
    local x,y=math.floor(mid.X),math.floor(mid.Y)
    local mode=(attempt-1)%4
    if mode<=1 then
        local method=mode==0 and "VIM CENTRO" or "VIM COM INSET"
        local ok,err=pcall(function()
            if mode==1 then
                local inset=game:GetService("GuiService"):GetGuiInset()
                x+=math.floor(inset.X)
                y+=math.floor(inset.Y)
            end
            local vim=game:GetService("VirtualInputManager")
            pcall(function() vim:SendMouseMoveEvent(x,y,game) end)
            vim:SendMouseButtonEvent(x,y,0,true,game,0)
            task.wait(0.12)
            vim:SendMouseButtonEvent(x,y,0,false,game,0)
        end)
        return ok,method,ok and nil or tostring(err)
    elseif mode==2 then
        -- Metodo alternativo usado quando o cliente bloqueia eventos VIM.
        local ok,err=pcall(function()
            local virtualUser=game:GetService("VirtualUser")
            local pos=Vector2.new(x,y)
            local cam=workspace.CurrentCamera
            virtualUser:Button1Down(pos,cam and cam.CFrame or CFrame.new())
            task.wait(0.10)
            virtualUser:Button1Up(pos,cam and cam.CFrame or CFrame.new())
        end)
        return ok,"VIRTUAL USER",ok and nil or tostring(err)
    else
        if not button:IsA("GuiButton") then
            return false,"SINAL","elemento de texto; somente clique virtual disponivel"
        end
        if type(firesignal)=="function" then
            local ok,err=pcall(function()
                firesignal(button.Activated)
            end)
            if ok then return true,"FIRESIGNAL ACTIVATED",nil end
            return false,"FIRESIGNAL ACTIVATED",tostring(err)
        end
        if type(getconnections)=="function" then
            local count=0
            local ok,err=pcall(function()
                for _,conn in ipairs(getconnections(button.Activated) or {}) do
                    if conn.Enabled~=false and type(conn.Function)=="function" then
                        conn.Function()
                        count+=1
                    end
                end
            end)
            local msg=nil
            if not ok then msg=tostring(err)
            elseif count==0 then msg="nenhuma callback" end
            return ok and count>0,"CONNECTIONS ACTIVATED",msg
        end
        local ok,err=pcall(function() button:Activate() end)
        return ok,"GUI ACTIVATE",ok and nil or tostring(err)
    end
end

