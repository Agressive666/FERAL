-- === AUTO QUEST DE DISTANCIA V8.7 ===
-- So se movimenta enquanto ha quest de viagem pendente.
-- Faz um percurso em quatro direcoes e consulta o progresso da GUI.
-- Nao altera diretamente o contador: apenas o servidor/jogo pode concluir.
local travelBaseHeading = nil
local travelLegIndex = 0

local function travelAmount(q)
    if not q then return nil, nil end
    local value = tostring(q.progress or "")
    local a, b = value:match("([%d%.]+)%s*/%s*([%d%.]+)")
    return tonumber(a), tonumber(b)
end

local function rotateHorizontal(v, angleDegrees)
    local radians = math.rad(angleDegrees)
    local sn, cs = math.sin(radians), math.cos(radians)
    return Vector3.new(v.X * cs - v.Z * sn, 0, v.X * sn + v.Z * cs)
end

local function travelNeedsToStop(char, hum)
    if not active or not CONFIG.AutoQuest or player.Character ~= char or not hum.Parent then return true, "personagem mudou" end
    local h, t = getHunger(), getThirst()
    local foodQuest = CONFIG.AutoFood and questPending("COMIDA") or nil
    local drinkQuest = CONFIG.AutoDrink and questPending("AGUA", questGenericDrink) or nil
    local hungerLimit = foodQuest and math.max(CONFIG.HungerStart, CONFIG.QuestEatStart) or CONFIG.HungerStart
    local thirstLimit = drinkQuest and math.max(CONFIG.DrinkStart, CONFIG.QuestDrinkStart) or CONFIG.DrinkStart
    if CONFIG.AutoGrass and herbivoreState() == true and h and h <= CONFIG.GrassStart then return true, "grama" end
    if CONFIG.AutoFood and h and h <= hungerLimit then return true, "comida" end
    if CONFIG.AutoDrink and t and t <= thirstLimit then return true, "agua" end
    if hum.MaxHealth > 0 and hum.Health / hum.MaxHealth * 100 < CONFIG.MinHealthPercent then
        return true, "vida baixa"
    end
    return false, nil
end

local function autoTravelQuest(requestedQuest)
    if not CONFIG.AutoQuest or not CONFIG.QuestTravelEnabled or not requestedQuest or requestedQuest.done then return end
    local actionEpoch = controlsEpoch
    local char, hum, root = actor()
    if not char then return end
    local questName = requestedQuest.title
    local startAt = os.clock()
    local initial, maximum = travelAmount(requestedQuest)
    local bestProgress = initial
    local lastProgressLog = 0
    local legs = 0
    local blockedLegs = 0

    -- Mantem a direcao base entre execucoes para continuar a rota quadrada.
    if not travelBaseHeading then
        local facing = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
        travelBaseHeading = facing.Magnitude > 0.01 and facing.Unit or Vector3.new(1, 0, 0)
    end

    print("AUTO QUEST DISTANCIA: iniciando", questName,
        "|", tostring(initial or "?"), "/", tostring(maximum or "?"),
        "| Speed", CONFIG.QuestTravelSpeed)

    while active and CONFIG.AutoQuest and controlsEpoch == actionEpoch
        and player.Character == char and os.clock() - startAt < CONFIG.QuestTravelSessionSeconds do

        local current = questSeen[questName]
        if not current or current.done then
            if current and current.done then
                print("AUTO QUEST DISTANCIA: CONCLUIDA", questName)
            end
            break
        end
        local interrupted, reason = travelNeedsToStop(char, hum)
        if interrupted then
            print("AUTO QUEST DISTANCIA: pausa para", reason)
            break
        end

        -- Gira 90 graus a cada trecho: vai e volta dentro da mesma regiao.
        local angle = (travelLegIndex % 4) * CONFIG.QuestTravelTurnDegrees
        local heading = rotateHorizontal(travelBaseHeading, angle)
        local waypoint = root.Position + heading * CONFIG.QuestTravelLegStuds
        local getDist = startMovement(hum, root,
            function() return waypoint end,
            function() return CONFIG.QuestTravelStopDistance end,
            CONFIG.QuestTravelSpeed)
        local legStart = os.clock()
        local lastMoved = os.clock()
        local lastPos = root.Position
        local reached = false
        local wasBlocked = false
        legs += 1
        print("AUTO QUEST DISTANCIA: trecho", legs,
            "| progresso:", current.progress ~= "" and current.progress or "sem leitura")

        while active and CONFIG.AutoQuest and controlsEpoch == actionEpoch
            and player.Character == char and os.clock() - legStart < CONFIG.QuestTravelLegTimeout
            and os.clock() - startAt < CONFIG.QuestTravelSessionSeconds do
            task.wait(0.25)
            local latest = questSeen[questName]
            if not latest or latest.done then break end
            local pause = travelNeedsToStop(char, hum)
            if pause then break end
            local dist, arrived = getDist()
            if arrived or dist <= CONFIG.QuestTravelStopDistance then
                reached = true
                break
            end
            if horizontal(lastPos, root.Position).Magnitude >= 1.5 then
                lastMoved = os.clock()
                lastPos = root.Position
            elseif os.clock() - lastMoved >= CONFIG.QuestTravelStuckSeconds then
                wasBlocked = true
                print("AUTO QUEST DISTANCIA: obstaculo no caminho; mudando direcao")
                break
            end
            local value, goal = travelAmount(latest)
            if value and (not bestProgress or value > bestProgress) then
                bestProgress = value
                if os.clock() - lastProgressLog >= 4 then
                    print("AUTO QUEST DISTANCIA:", value, "/", goal or "?", "m")
                    lastProgressLog = os.clock()
                end
            end
        end
        stopMovement()
        travelLegIndex += 1
        if wasBlocked then blockedLegs += 1 else blockedLegs = 0 end
        if blockedLegs >= 4 then
            -- Todas as direcoes proximas parecem bloqueadas; nao ficar forçando.
            warn("AUTO QUEST DISTANCIA: sem trajeto livre; pausa para evitar travamento")
            break
        end
        if not reached and not wasBlocked then
            print("AUTO QUEST DISTANCIA: trecho interrompido ou tempo limite")
        end
        local latest = questSeen[questName]
        if not latest or latest.done then break end
        local interruptedAgain = travelNeedsToStop(char, hum)
        if interruptedAgain then break end
        task.wait(0.2)
    end
    stopMovement()
    local final = questSeen[questName]
    if not CONFIG.AutoQuest or controlsEpoch ~= actionEpoch then return end
    if final and final.done then
        print("AUTO QUEST DISTANCIA: missão concluida pelo jogo!", questName)
    else
        print("AUTO QUEST DISTANCIA: pausa / retomada automatica |",
            final and final.progress or "sem leitura")
    end
end

