-- V8.9.28: o log "R enviado" nunca foi prova de que o FERAL recebeu a tecla.
-- Inicia por VIM, confirma o progresso real da quest e so entao trava as
-- automacoes ate confirmar a saida do descanso. Sem progresso: cooldown.
local function doRestQuest(q)
    if not active or not CONFIG.AutoQuest or not q or q.done then return end
    if os.clock() < (restRetryAt[q.title] or 0) then return end
    local epoch=controlsEpoch
    local char,hum,root=actor()
    if not char then return end
    stopMovement()
    if restGuard.blocked and not restGateReady() then return end

    local baseline=animationTrackIds(hum)
    local initial=questSeen[q.title] or q
    local baseProgress=tonumber(tostring(initial.progress):match("(%d+)%s*/")) or 0
    restGuard.lastProgress=baseProgress
    restGuard.phase="TENTANDO INICIAR"
    restGuard.inputMethod="nenhum"
    restGuard.lastInputOK=nil
    restGuard.lastInputError=nil

    local function checkEntry(seconds)
        local deadline=os.clock()+seconds
        while active and CONFIG.AutoQuest and controlsEpoch==epoch and player.Character==char
            and root.Parent and os.clock()<deadline do
            -- Tenta atualizar a leitura; outros scanners do jogo continuam em paralelo.
            pcall(questScan)
            local data=questSeen[q.title]
            local number=data and tonumber(tostring(data.progress):match("(%d+)%s*/"))
            if number then restGuard.lastProgress=number end
            if data and data.done then return true,"DONE",number or 0 end
            if number and number>baseProgress then
                return true,"contador avancou para "..number,number
            end
            local resting,source=detectResting(char,hum)
            if resting==true then return true,"estado descanso: "..tostring(source),number or baseProgress end
            task.wait(0.5)
        end
        return false,"contador nao avancou",restGuard.lastProgress
    end

    local beforeRest,beforeSource=detectResting(char,hum)
    local started=false
    local enteredVia="nenhum"
    if beforeRest==true then
        started=true
        enteredVia="estado preexistente"
        print("AUTO QUEST REST: ja estava deitado |",beforeSource)
    else
        -- Se o VIM nao for processado, tenta keypress do executor apenas
        -- depois de esperar e verificar que o descanso nao comecou.
        for _,method in ipairs({"vim","executor"}) do
            if not active or not CONFIG.AutoQuest or controlsEpoch~=epoch
                or player.Character~=char then return end
            if method=="executor" and (type(keypress)~="function"
                or type(keyrelease)~="function") then
                print("AUTO QUEST REST: executor R indisponivel; ignorando fallback")
                break
            end
            local ok,err=pressRestKey(method,CONFIG.QuestRestKeyHold)
            restGuard.inputMethod=method
            restGuard.lastInputOK=ok
            restGuard.lastInputError=ok and nil or tostring(err)
            restGuard.attempts += 1
            print("AUTO QUEST REST: R enviado via",method,"| aceito pela API:",ok,
                "| aguardando contador acima de",baseProgress)
            if ok then
                local entered,reason=checkEntry(CONFIG.QuestRestStartCheckSeconds)
                if entered then
                    started=true
                    enteredVia=method
                    print("AUTO QUEST REST: INICIO CONFIRMADO |",reason)
                    break
                end
                print("AUTO QUEST REST: R nao confirmado via",method,"|",reason)
                -- Nao alterna R novamente caso tenha sinal de que ja esta deitado.
                local resting,source=detectResting(char,hum)
                if resting==true then
                    started=true
                    enteredVia=method
                    print("AUTO QUEST REST: descanso detectado apos tentativa |",source)
                    break
                end
            end
        end
    end

    if not started then
        restGuard.failedStarts += 1
        restGuard.phase="R NAO RECONHECIDO"
        restRetryAt[q.title]=os.clock()+CONFIG.QuestRestFailedStartCooldown
        local isRest,source=detectResting(char,hum)
        if isRest==true then
            -- Evidencia de que deitou: segura a caca para evitar atacar deitado.
            restGuard.blocked=true
            restGuard.character=char
            restGuard.lastSource=source
            warn("AUTO QUEST REST: personagem deitado apesar de contador 0; " ..
                "trava de seguranca ativa | "..tostring(source))
        else
            clearRestGuard("R sem confirmacao de descanso")
            restGuard.phase="FALHOU; AGUARDANDO NOVA TENTATIVA"
            warn("AUTO QUEST REST: FALHA AO INICIAR | ",q.title,
                "| contador:",restGuard.lastProgress,
                "| cooldown:",CONFIG.QuestRestFailedStartCooldown,
                "s; outras quests liberadas")
        end
        return
    end

    restGuard.blocked=true
    restGuard.character=char
    restGuard.observedRest=true
    restGuard.knownRestTracks={}
    restGuard.lastTry=0
    restGuard.lastWarning=0
    restGuard.phase="DESCANSANDO"
    restRetryAt[q.title]=os.clock()+CONFIG.QuestRestCooldown
    -- Nao rotula automaticamente novas animacoes como descanso.
    -- O estado deve vir de atributos / animacoes com nome explicito.
    local lastNumber=restGuard.lastProgress
    local lastChange=os.clock()
    local lastPrint=0
    local startedAt=os.clock()
    while active and CONFIG.AutoQuest and controlsEpoch==epoch and player.Character==char
        and root.Parent and os.clock()-startedAt<CONFIG.QuestRestTimeout do
        task.wait(1)
        local current=questSeen[q.title]
        if current and current.done then
            print("AUTO QUEST REST: DONE confirmado",q.title)
            break
        end
        if current then
            local number=tonumber(tostring(current.progress):match("(%d+)%s*/"))
            if number and number>lastNumber then
                lastNumber=number
                restGuard.lastProgress=number
                lastChange=os.clock()
            end
            if os.clock()-lastPrint>=10 then
                print("AUTO QUEST REST:",current.title,"|",current.progress)
                lastPrint=os.clock()
            end
        end
        local h,t=getHunger(),getThirst()
        if (CONFIG.AutoDrink and t and t<CONFIG.QuestNamedDrinkSafetyThreshold)
            or (CONFIG.AutoFood and h and h<50) then
            print("AUTO QUEST REST: interrompendo por necessidade de sobrevivencia")
            break
        end
        if os.clock()-lastChange>=CONFIG.QuestRestNoProgressSeconds then
            warn("AUTO QUEST REST: contador parou; tentando encerrar descanso")
            break
        end
    end
    if not active or player.Character~=char or not root.Parent then
        clearRestGuard("personagem reiniciado ou automacao desligada")
        return
    end
    restGuard.phase="TENTANDO LEVANTAR"
    task.wait(1.4)
    local beforeExit,exitSource=detectResting(char,hum)
    if beforeExit==false then
        clearRestGuard(exitSource)
        restGuard.phase="EM ESPERA"
        return
    end
    -- Preferencia pelo metodo que conseguiu iniciar o descanso.
    local exitMethod=enteredVia=="executor" and "executor" or "vim"
    print("AUTO QUEST REST: enviando R para LEVANTAR via",exitMethod,
        "| estado:",tostring(beforeExit))
    restGuard.lastTry=os.clock()
    local ok,err=pressRestKey(exitMethod,CONFIG.QuestRestKeyHold)
    restGuard.inputMethod=exitMethod
    restGuard.lastInputOK=ok
    restGuard.lastInputError=ok and nil or tostring(err)
    task.wait(2.2)
    local after,afterSource=detectResting(char,hum)
    restGuard.lastSource=afterSource
    if after==false then
        clearRestGuard(afterSource)
        restGuard.phase="EM ESPERA"
        return
    end
    if after==true then
        -- Apenas quando ha evidencia de descanso: pode tentar metodo alternativo.
        task.wait(2)
        local alt=exitMethod=="vim" and "executor" or "vim"
        print("AUTO QUEST REST: ainda deitado; tentando levantar via",alt)
        restGuard.lastTry=os.clock()
        restGuard.attempts += 1
        pressRestKey(alt,CONFIG.QuestRestKeyHold)
        task.wait(2.2)
        local final,finalSource=detectResting(char,hum)
        restGuard.lastSource=finalSource
        if final==false then
            clearRestGuard(finalSource)
            restGuard.phase="EM ESPERA"
            return
        end
    end
    restGuard.phase="SAIDA NAO CONFIRMADA"
    if after==nil then
        -- Quando o jogo nao expoe estado, nenhum sinal permite afirmar que
        -- permanece deitado. O bloqueio sera temporario, nao permanente.
        restRetryAt[q.title]=os.clock()+CONFIG.QuestRestFailedStartCooldown
        warn("AUTO QUEST REST: estado depois do R desconhecido; " ..
            "desbloqueio automatico em " .. CONFIG.QuestRestUnknownUnlockSeconds ..
            "s, confira visualmente se levantou")
        restGuard.unknownSince=os.clock()
    else
        warn("AUTO QUEST REST: ainda ha evidencia de descanso; " ..
            "movimentos e ataques aguardam saida real")
    end
end

local function findTerritoryZone()
    local _,_,root=actor()
    if not root then return nil end
    local folder=workspace:FindFirstChild("FeralNPCs")
    local best,bestDist,bestName=nil,CONFIG.QuestTerritoryScanRadius,nil
    for _,inst in ipairs(workspace:GetDescendants()) do
        if (inst:IsA("BasePart") or inst:IsA("Model"))
            and not (folder and inst:IsDescendantOf(folder)) then
            local n=inst.Name:lower():gsub("[%s_-]","")
            local isZone=n:find("territoryzone",1,true)
                or n:find("claimzone",1,true)
                or n:find("capturezone",1,true)
                or n:find("capturepoint",1,true)
                or n=="territory" or n=="claimterritory"
            if isZone then
                local pos=inst:IsA("BasePart") and inst.Position or inst:GetPivot().Position
                if validPosition(pos) and math.abs(root.Position.Y-pos.Y)<110 then
                    local dist=horizontal(root.Position,pos).Magnitude
                    if dist<bestDist then
                        best,bestDist,bestName=pos,dist,inst:GetFullName()
                    end
                end
            end
        end
    end
    return best,bestDist,bestName
end

local function doTerritoryQuest(q)
    if not active or not CONFIG.AutoQuest or not q or q.done then return end
    if os.clock() < (territoryRetryAt[q.title] or 0) then return end
    territoryRetryAt[q.title]=os.clock()+CONFIG.QuestTerritoryCooldown
    local epoch=controlsEpoch
    local char,hum,root=actor()
    if not char then return end
    local pos,dist,path=findTerritoryZone()
    if pos then
        print("AUTO QUEST TERRITORIO: area identificada",path,"| distancia",math.floor(dist))
        local getDist=startMovement(hum,root,function() return pos end,
            function() return 12 end,
            function(d) return d>40 and 35 or 14 end)
        local started=os.clock()
        local lastProgress=started
        local nearest=dist
        while active and CONFIG.AutoQuest and controlsEpoch==epoch and root.Parent
            and player.Character==char and os.clock()-started<CONFIG.QuestVisitTimeout do
            task.wait(.3)
            local current=questSeen[q.title]
            if current and current.done then break end
            local d,reached=getDist()
            if reached or d<=12 then break end
            if d<nearest-1 then
                nearest=d
                lastProgress=os.clock()
            end
            if os.clock()-lastProgress>CONFIG.StuckTimeout then
                warn("AUTO QUEST TERRITORIO: caminho bloqueado")
                break
            end
        end
        stopMovement()
    else
        print("AUTO QUEST TERRITORIO: zona sem marcador confiavel no Workspace.")
        print("AUTO QUEST TERRITORIO: entre em qualquer territorio; vou acompanhar o DONE")
    end
    if not active or not CONFIG.AutoQuest or controlsEpoch~=epoch then return end
    local startWait=os.clock()
    print("AUTO QUEST TERRITORIO: aguardando captura no local")
    while active and CONFIG.AutoQuest and controlsEpoch==epoch and player.Character==char
        and os.clock()-startWait<CONFIG.QuestTerritoryWaitSeconds do
        task.wait(1.5)
        local latest=questSeen[q.title]
        if latest and latest.done then
            print("AUTO QUEST TERRITORIO: MISSAO CONCLUIDA",q.title)
            return
        end
        local h,t=getHunger(),getThirst()
        if (CONFIG.AutoFood and h and h<=CONFIG.HungerStart)
            or (CONFIG.AutoDrink and t and t<=CONFIG.DrinkStart) then
            print("AUTO QUEST TERRITORIO: pausa para comer/beber")
            break
        end
    end
    print("AUTO QUEST TERRITORIO: ainda pendente; nenhuma captura confirmada")
end

-- === AUTO QUEST DE DISTANCIA V8.7 ===
-- So se movimenta enquanto ha quest de viagem pendente.
-- Faz um percurso em quatro direcoes e consulta o progresso da GUI.
-- Nao altera diretamente o contador: apenas o servidor/jogo pode concluir.
local travelBaseHeading = nil
local travelLegIndex = 0

local function travelAmount(q)
    if not q then return nil, nil end
    local value = tostring(q.progress or "")
    local a, b = value:match("([%d%.]+)%s*/%s*([%d%.]+)")
    return tonumber(a), tonumber(b)
end

local function rotateHorizontal(v, angleDegrees)
    local radians = math.rad(angleDegrees)
    local sn, cs = math.sin(radians), math.cos(radians)
    return Vector3.new(v.X * cs - v.Z * sn, 0, v.X * sn + v.Z * cs)
end

local function travelNeedsToStop(char, hum)
    if not active or not CONFIG.AutoQuest or player.Character ~= char or not hum.Parent then return true, "personagem mudou" end
    local h, t = getHunger(), getThirst()
    local foodQuest = CONFIG.AutoFood and questPending("COMIDA") or nil
    local drinkQuest = CONFIG.AutoDrink and questPending("AGUA", questGenericDrink) or nil
    local hungerLimit = foodQuest and math.max(CONFIG.HungerStart, CONFIG.QuestEatStart) or CONFIG.HungerStart
    local thirstLimit = drinkQuest and math.max(CONFIG.DrinkStart, CONFIG.QuestDrinkStart) or CONFIG.DrinkStart
    if CONFIG.AutoGrass and herbivoreState() ~= false and h and h <= CONFIG.GrassStart then return true, "grama" end
    if CONFIG.AutoFood and h and h <= hungerLimit then return true, "comida" end
    if CONFIG.AutoDrink and t and t <= thirstLimit then return true, "agua" end
    if hum.MaxHealth > 0 and hum.Health / hum.MaxHealth * 100 < CONFIG.MinHealthPercent then
        return true, "vida baixa"
    end
    return false, nil
end

local function autoTravelQuest(requestedQuest)
    if not CONFIG.AutoQuest or not CONFIG.QuestTravelEnabled or not requestedQuest or requestedQuest.done then return end
    local actionEpoch = controlsEpoch
    local char, hum, root = actor()
    if not char then return end
    local questName = requestedQuest.title
    local startAt = os.clock()
    local initial, maximum = travelAmount(requestedQuest)
    local bestProgress = initial
    local lastProgressLog = 0
    local legs = 0
    local blockedLegs = 0

    -- Mantem a direcao base entre execucoes para continuar a rota quadrada.
    if not travelBaseHeading then
        local facing = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
        travelBaseHeading = facing.Magnitude > 0.01 and facing.Unit or Vector3.new(1, 0, 0)
    end

    print("AUTO QUEST DISTANCIA: iniciando", questName,
        "|", tostring(initial or "?"), "/", tostring(maximum or "?"),
        "| Speed", CONFIG.QuestTravelSpeed)

    while active and CONFIG.AutoQuest and controlsEpoch == actionEpoch
        and player.Character == char and os.clock() - startAt < CONFIG.QuestTravelSessionSeconds do

        local current = questSeen[questName]
        if not current or current.done then
            if current and current.done then
                print("AUTO QUEST DISTANCIA: CONCLUIDA", questName)
            end
            break
        end
        local interrupted, reason = travelNeedsToStop(char, hum)
        if interrupted then
            print("AUTO QUEST DISTANCIA: pausa para", reason)
            break
        end

        -- Gira 90 graus a cada trecho: vai e volta dentro da mesma regiao.
        local angle = (travelLegIndex % 4) * CONFIG.QuestTravelTurnDegrees
        local heading = rotateHorizontal(travelBaseHeading, angle)
        local waypoint = root.Position + heading * CONFIG.QuestTravelLegStuds
        local getDist = startMovement(hum, root,
            function() return waypoint end,
            function() return CONFIG.QuestTravelStopDistance end,
            CONFIG.QuestTravelSpeed)
        local legStart = os.clock()
        local lastMoved = os.clock()
        local lastPos = root.Position
        local reached = false
        local wasBlocked = false
        legs += 1
        print("AUTO QUEST DISTANCIA: trecho", legs,
            "| progresso:", current.progress ~= "" and current.progress or "sem leitura")

        while active and CONFIG.AutoQuest and controlsEpoch == actionEpoch
            and player.Character == char and os.clock() - legStart < CONFIG.QuestTravelLegTimeout
            and os.clock() - startAt < CONFIG.QuestTravelSessionSeconds do
            task.wait(0.25)
            local latest = questSeen[questName]
            if not latest or latest.done then break end
            local pause = travelNeedsToStop(char, hum)
            if pause then break end
            local dist, arrived = getDist()
            if arrived or dist <= CONFIG.QuestTravelStopDistance then
                reached = true
                break
            end
            if horizontal(lastPos, root.Position).Magnitude >= 1.5 then
                lastMoved = os.clock()
                lastPos = root.Position
            elseif os.clock() - lastMoved >= CONFIG.QuestTravelStuckSeconds then
                wasBlocked = true
                print("AUTO QUEST DISTANCIA: obstaculo no caminho; mudando direcao")
                break
            end
            local value, goal = travelAmount(latest)
            if value and (not bestProgress or value > bestProgress) then
                bestProgress = value
                if os.clock() - lastProgressLog >= 4 then
                    print("AUTO QUEST DISTANCIA:", value, "/", goal or "?", "m")
                    lastProgressLog = os.clock()
                end
            end
        end
        stopMovement()
        travelLegIndex += 1
        if wasBlocked then blockedLegs += 1 else blockedLegs = 0 end
        if blockedLegs >= 4 then
            -- Todas as direcoes proximas parecem bloqueadas; nao ficar forçando.
            warn("AUTO QUEST DISTANCIA: sem trajeto livre; pausa para evitar travamento")
            break
        end
        if not reached and not wasBlocked then
            print("AUTO QUEST DISTANCIA: trecho interrompido ou tempo limite")
        end
        local latest = questSeen[questName]
        if not latest or latest.done then break end
        local interruptedAgain = travelNeedsToStop(char, hum)
        if interruptedAgain then break end
        task.wait(0.2)
    end
    stopMovement()
    local final = questSeen[questName]
    if not CONFIG.AutoQuest or controlsEpoch ~= actionEpoch then return end
    if final and final.done then
        print("AUTO QUEST DISTANCIA: missão concluida pelo jogo!", questName)
    else
        print("AUTO QUEST DISTANCIA: pausa / retomada automatica |",
            final and final.progress or "sem leitura")
    end
end

