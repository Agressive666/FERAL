local respawnState = {
    dead=false, since=0, lastClick=0, attempts=0,
    deaths=0, successes=0, lastStatus="INICIANDO", lastButton="nenhum",
    lastMethod="nenhum", lastError=nil, lastDeathVitals=nil,
    observedDied=false, aliveVitals=nil,
    uiDebug="NAO OBSERVADO",lastMissingButtonLog=-math.huge
