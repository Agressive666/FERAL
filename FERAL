-- THE GOAT | STAMINA V2 EXPERIMENTAL (MODULO SEPARADO)
-- Executar somente DEPOIS da THE GOAT V8.9.34 funcional.
-- Nao altera, nao recompila e nao substitui o script principal.
-- Fonte identificada nos logs: Character:GetAttribute("Stamina")
-- Capacidade real: Character:GetAttribute("StaminaMax")
-- Exaustao: Character:GetAttribute("StaminaOut")
-- IMPORTANTE: mudar atributos no cliente NAO garante que o servidor aceite a mudanca.
-- Diagnostico: print(_G.TGStaminaV2.status().last)
-- Desligar: _G.TGStaminaV2.stop()

do
    local ok, err = pcall(function()
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local p = Players.LocalPlayer
        assert(p ~= nil, "LocalPlayer indisponivel")

        -- Desliga qualquer tentativa de stamina anterior, sem tocar no THE GOAT.
        local previous = _G.TGStamina
        if type(previous) == "table" and type(previous.stop) == "function" then
            pcall(previous.stop)
        end
        local earlier = _G.TGStaminaV2
        if type(earlier) == "table" and type(earlier.stop) == "function" then
            pcall(earlier.stop)
        end

        local state = {
            running = true,
            enabled = true,
            character = "AGUARDANDO",
            stamina = nil,
            maxStamina = nil,
            staminaOut = nil,
            changes = 0,
            writes = 0,
            rejectedNow = 0,
            exhaustionResets = 0,
            errors = 0,
            lastError = nil,
            last = "INICIANDO",
            lastReason = "",
            lastCorrectionAt = 0,
        }
        local char = nil
        local changedConn = nil
        local outConn = nil
        local characterConn = nil
        local heartbeatConn = nil
        local updating = false
        local lastLog = 0

        local function numeric(v)
            return type(v) == "number" and v == v and v >= 0 and v < 100000
        end

        local function disconnectChar()
            if changedConn then changedConn:Disconnect(); changedConn = nil end
            if outConn then outConn:Disconnect(); outConn = nil end
        end

        local function refill(reason)
            if updating or not state.running or not state.enabled or not char or not char.Parent then
                return
            end
            local current = char:GetAttribute("Stamina")
            local cap = char:GetAttribute("StaminaMax")
            local exhausted = char:GetAttribute("StaminaOut")
            state.stamina, state.maxStamina, state.staminaOut = current, cap, exhausted
            if not numeric(current) or not numeric(cap) or cap <= 0 then
                state.last = "ATRIBUTOS INDISPONIVEIS / INVALIDOS"
                return
            end

            updating = true
            local succeeded, writeErr = pcall(function()
                if current < cap - 0.01 then
                    char:SetAttribute("Stamina", cap)
                    state.writes = state.writes + 1
                    state.lastCorrectionAt = os.clock()
                    state.lastReason = reason
                    -- Leitura imediata confirma somente a escrita LOCAL, nao o servidor.
                    local readback = char:GetAttribute("Stamina")
                    if not numeric(readback) or readback < cap - 0.01 then
                        state.rejectedNow = state.rejectedNow + 1
                    end
                end
                if exhausted == true then
                    char:SetAttribute("StaminaOut", false)
                    state.exhaustionResets = state.exhaustionResets + 1
                end
            end)
            updating = false
            if not succeeded then error(writeErr) end
            state.stamina = char:GetAttribute("Stamina")
            state.staminaOut = char:GetAttribute("StaminaOut")
            state.last = state.writes > 0 and "REPOSICAO LOCAL EM TESTE" or "ESTAMINA NO MAXIMO"
        end

        local function safeRefill(reason)
            local passed, failure = pcall(refill, reason)
            if not passed then
                state.errors = state.errors + 1
                state.lastError = tostring(failure)
                state.last = "ERRO: " .. tostring(failure)
            end
        end

        local function attach(c)
            disconnectChar()
            char = c
            state.character = c and c.Name or "AGUARDANDO"
            if not c then return end
            changedConn = c:GetAttributeChangedSignal("Stamina"):Connect(function()
                if not updating then
                    state.changes = state.changes + 1
                    safeRefill("EVENTO_STAMINA")
                end
            end)
            outConn = c:GetAttributeChangedSignal("StaminaOut"):Connect(function()
                if not updating then safeRefill("EVENTO_EXAUSTAO") end
            end)
            safeRefill("INICIO")
        end

        local api = {}
        function api.status()
            -- Retorna um snapshot, para o usuario poder imprimir sem alterar estado.
            local snapshot = {}
            for k, v in pairs(state) do snapshot[k] = v end
            if char and char.Parent then
                snapshot.stamina = char:GetAttribute("Stamina")
                snapshot.maxStamina = char:GetAttribute("StaminaMax")
                snapshot.staminaOut = char:GetAttribute("StaminaOut")
            end
            return snapshot
        end
        function api.setEnabled(value)
            state.enabled = value == true
            state.last = state.enabled and "LIGADO" or "DESLIGADO"
            if state.enabled then safeRefill("REATIVAR") end
            return state.enabled
        end
        function api.stop()
            if not state.running then return end
            state.running = false
            state.enabled = false
            state.last = "PARADO"
            disconnectChar()
            if characterConn then characterConn:Disconnect(); characterConn = nil end
            if heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
        end
        _G.TGStaminaV2 = api

        attach(p.Character)
        characterConn = p.CharacterAdded:Connect(attach)
        heartbeatConn = RunService.Heartbeat:Connect(function()
            if not state.running then return end
            if p.Character ~= char then attach(p.Character) end
            -- Heartbeat evita intervalo de 0,12s do modulo anterior.
            safeRefill("HEARTBEAT")
            if os.clock() - lastLog > 20 then
                lastLog = os.clock()
                if not numeric(state.maxStamina) then
                    warn("TG STAMINA V2: nao detectou StaminaMax; personagem:", state.character)
                end
            end
        end)
        print("THE GOAT STAMINA V2: teste isolado iniciado | nao modifica V8.9.34")
    end)
    if not ok then
        warn("THE GOAT STAMINA V2: nao iniciou; o script principal continua independente:", tostring(err))
    end
end
