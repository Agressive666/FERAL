-- Motor fiel ao script original: WolfActions Bite -> BiteHit, apenas FeralNPCs.
-- Nao move personagem, nao mira jogadores, nao transforma tentativas em abates.
local auraRuntime = {
    attempts=0, lastTarget=nil, lastTargetText="Alvo: desativado",
    lastError=nil, lastAttackAt=0, lastMethod="Bite/BiteHit"
}
local auraNPCFolder = workspace:FindFirstChild("FeralNPCs")
local auraRemote = game:GetService("ReplicatedStorage"):FindFirstChild("WolfActions")

local function auraGetRoot()
    local char,hum,root=actor()
    if not char or not hum or hum.Health<=0 then return nil end
    return root
end
local function auraAliveNPC(npc)
    if not (npc and npc:IsA("Model") and npc.Parent) then return false end
    if Players:GetPlayerFromCharacter(npc) then return false end
    if npc:GetAttribute("FeralDead")==true or npc:GetAttribute("IsDead")==true
        or npc:GetAttribute("Dead")==true or npc:GetAttribute("Alive")==false then return false end
    local hum=npc:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health<=0 then return false end
    return npc:FindFirstChildWhichIsA("BasePart",true)~=nil
end
local function auraNearestNPC(root)
    local best,bestDist=nil,CONFIG.AuraDetectRange
    if not auraNPCFolder or not auraNPCFolder.Parent then
        auraNPCFolder=workspace:FindFirstChild("FeralNPCs")
    end
    if not auraNPCFolder then return nil,bestDist end
    local function scan(folder)
        for _,obj in ipairs(folder:GetChildren()) do
            if obj:IsA("Folder") then
                scan(obj)
            elseif obj:IsA("Model") and auraAliveNPC(obj) then
                local dist=(obj:GetPivot().Position-root.Position).Magnitude
                if dist<bestDist then best,bestDist=obj,dist end
            end
        end
    end
    scan(auraNPCFolder)
    return best,bestDist
end
local function auraSetEnabled(state)
    CONFIG.AutoAttack=state==true
    auraRuntime.lastTarget=nil
    if CONFIG.AutoAttack then
        auraRuntime.lastTargetText="Alvo: procurando NPC..."
        setActivity("AutoAttack","PROCURANDO NPC")
    else
        auraRuntime.lastTargetText="Alvo: desativado"
        setActivity("AutoAttack","DESATIVADO")
    end
    print("THE GOAT AURA V2:",CONFIG.AutoAttack and "ON" or "OFF",
        "| alcance",CONFIG.AuraDetectRange,"studs")
end
-- Loop independente da fila do AutoQuest: apenas ataques de proximidade.
task.spawn(function()
    while active do
        local ok,err=pcall(function()
            if not CONFIG.AutoAttack then return end
            local root=auraGetRoot()
            if not root then
                auraRuntime.lastTarget=nil
                auraRuntime.lastTargetText="Alvo: aguardando personagem"
                setActivity("AutoAttack","AGUARDANDO PERSONAGEM")
                return
            end
            if not auraRemote or not auraRemote.Parent then
                auraRemote=game:GetService("ReplicatedStorage"):FindFirstChild("WolfActions")
            end
            if not auraRemote or not auraRemote:IsA("RemoteEvent") then
                auraRuntime.lastTargetText="Alvo: WolfActions indisponivel"
                setActivity("AutoAttack","SEM REMOTE")
                return
            end
            local npc,dist=auraNearestNPC(root)
            if not npc then
                auraRuntime.lastTarget=nil
                auraRuntime.lastTargetText="Alvo: nenhum NPC no alcance"
                setActivity("AutoAttack","SEM NPC")
                return
            end
            auraRuntime.lastTargetText=string.format("Alvo: %s (%.0f studs)",npc.Name,dist)
            setActivity("AutoAttack","ATACANDO NPC")
            if npc~=auraRuntime.lastTarget then
                auraRuntime.lastTarget=npc
                print("[THE GOAT AURA] Novo alvo NPC:",npc.Name)
            end
            local timestamp=workspace:GetServerTimeNow()
            auraRemote:FireServer("Bite",timestamp)
            task.wait(CONFIG.AuraBiteHitDelay)
            if not active or not CONFIG.AutoAttack or not npc.Parent
                or not auraNPCFolder or not npc:IsDescendantOf(auraNPCFolder)
                or not auraAliveNPC(npc) then return end
            local latestRoot=auraGetRoot()
            if not latestRoot then return end
            if (npc:GetPivot().Position-latestRoot.Position).Magnitude>CONFIG.AuraDetectRange then return end
            auraRemote:FireServer("BiteHit",{m=npc,t=timestamp})
            auraRuntime.attempts+=1
            auraRuntime.lastAttackAt=os.clock()
        end)
        if not ok then
            auraRuntime.lastError=tostring(err)
            setActivity("AutoAttack","ERRO TEMPORARIO")
            warn("THE GOAT AURA V2: tentativa falhou:",err)
        end
        task.wait(CONFIG.AuraAttackInterval)
    end
end)

