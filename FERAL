local function walkToCarcass(npc)
    local char, hum, root = actor()
    if not char or not CONFIG.AutoFood then return false end
    local actionEpoch = controlsEpoch
    local getDistance = startMovement(hum, root, function()
        return foodPosition(npc)
    end, function()
        local state = promptState()
        if state == "EAT" or state == "EATING" then return 12 end
        return 3
    end)
    local started = os.clock()
    local lastAdvance = started
    local previousBest = horizontal(root.Position, foodPosition(npc)).Magnitude
    local lastLog = 0
    local arrived = false
    while active and CONFIG.AutoFood and controlsEpoch == actionEpoch
        and npc.Parent and player.Character == char and os.clock() - started < CONFIG.TravelTimeout do
        task.wait(0.25)
        local hunger = getHunger()
        if CONFIG.AutoDrink and getThirst() and getThirst() <= CONFIG.DrinkStart then
            print("Auto Eat: pausando para beber")
            break
        end
        if not root.Parent or (hunger and hunger >= CONFIG.HungerStop) then break end
        local food = npc:GetAttribute("FoodLeft")
        if type(food) ~= "number" or food <= 0 then break end
        local d, reached = getDistance()
        local state = promptState()
        if state == "EAT" or state == "EATING" then
            arrived = true
            break
        end
        if d < previousBest - 0.6 then
            previousBest = d
            lastAdvance = os.clock()
        end
        if reached then
            task.wait(1)
            arrived = promptState() == "EAT" or promptState() == "EATING"
            break
        end
        if os.clock() - lastAdvance >= CONFIG.StuckTimeout then
            warn("Auto Eat: bloqueio no trajeto")
            break
        end
        if os.clock() - lastLog >= 5 then
            print("Indo comer", npc.Name, "distancia", math.floor(d))
            lastLog = os.clock()
        end
    end
    stopMovement()
    return arrived
end

local function eatCarcass(npc)
    if not CONFIG.AutoFood then return false end
    local actionEpoch = controlsEpoch
    local started = os.clock()
    local lastGain = started
    local previous = getHunger() or 0
    local lastPress = 0
    local missingPromptSince = nil
    while active and CONFIG.AutoFood and controlsEpoch == actionEpoch
        and npc.Parent and os.clock() - started < CONFIG.EatTimeout do
        local h = getHunger()
        local food = npc:GetAttribute("FoodLeft")
        if not h then return false end
        if h >= CONFIG.HungerStop then return true end
        if CONFIG.AutoDrink and getThirst() and getThirst() <= CONFIG.DrinkStart then
            print("Auto Eat: pausando para beber")
            return false
        end
        if type(food) ~= "number" or food <= 0 then return false end
        local state = promptState()
        if state == "EAT" and os.clock() - lastPress >= 3 then
            missingPromptSince = nil
            lastPress = os.clock()
            pressE()
        elseif state == "EATING" then
            missingPromptSince = nil
        elseif state ~= "EAT" then
            -- Pode sumir por instantes entre animacoes. Evita abandonar a carcaca imediatamente.
            missingPromptSince = missingPromptSince or os.clock()
            if os.clock() - missingPromptSince > 5.0 then
                warn("Auto Eat: prompt ausente por 5s; trocando de carcaça")
                return false
            end
        end
        task.wait(1)
        local after = getHunger()
        if after and after > previous + 0.05 then
            previous = after
            lastGain = os.clock()
            print("Alimentando:", math.floor(after), "%")
        end
        if os.clock() - lastGain > 17 then
            warn("Sem aumento de Hunger ao comer")
            return false
        end
    end
    return false
end

local function chaseAndAttack(npc, questTitle, amberMode)
    local char, hum, root = actor()
    if not char or not CONFIG.AutoFood or (questTitle and not CONFIG.AutoQuest) then return false end
    if not restGateReady() then
        warn("AUTO HUNT: ataque cancelado; lobo ainda nao levantou do descanso")
        return false
    end
    if amberMode then
        local ready = amberReady(true)
        if not ready then return false end
    end
    local actionEpoch = controlsEpoch
    local preyGoal, preyVelocity, preyPosition = makePreyTracker(
        npc, root, 0.22, 7.5)
    local getDistance = startMovement(hum, root, function()
        return npc:GetAttribute("FeralDead") == true and foodPosition(npc) or preyGoal()
    end, function()
        -- Pequena margem para entrar no alcance, evitando parar exatamente no limite.
        return math.max(0.5, CONFIG.AttackDistance - 0.6)
    end, nil, false, {velocity=preyVelocity, lookAt=preyPosition})
    local started = os.clock()
    local lastMoved = started
    local lastPos = root.Position
    local nextLog = 0
    local previousNPCHealth = npcHealth(npc)
    local verifiedHits = 0
    runtimeStatus.lastAttackMethod = "MANUAL"
    local questCompletedDuringChase = false
    -- Registra somente a morte confirmada pelo atributo FeralDead.
    -- Contagem unica por NPC, mesmo que seja encontrado por outra automacao.
    local function recordConfirmedKill()
        if npc:GetAttribute("FeralDead") ~= true or countedNPCKills[npc] then return end
        countedNPCKills[npc] = true
        totalConfirmedKills += 1
        if amberMode then amberKills += 1 end
        print("ABATES CONFIRMADOS | Farm Amber:", amberKills,
            "| Total sessao:", totalConfirmedKills,
            "| NPC:", npc.Name, "| credito real de Amber nao verificado")
    end
    print(amberMode and "GET AMBER HUNT:" or "AUTO HUNT:", npc.Name,
        "| Species:", tostring(npc:GetAttribute("Species")))
    print("Vida NPC visivel:", tostring(previousNPCHealth))
    while active and CONFIG.AutoFood and controlsEpoch == actionEpoch
        and (not questTitle or CONFIG.AutoQuest) and npc.Parent and player.Character == char
        and os.clock() - started < (amberMode and CONFIG.AmberHuntTimeout or CONFIG.ChaseTimeout) do

        task.wait(0.13)
        -- Os botoes ou o respawn podem cancelar a rotina durante a espera.
        if not active or not CONFIG.AutoFood or controlsEpoch ~= actionEpoch
            or (questTitle and not CONFIG.AutoQuest) or (amberMode and not CONFIG.GetAmber)
            or not npc.Parent or player.Character ~= char or not root.Parent
            or not hum.Parent or hum.Health <= 0 then break end
        if npc:GetAttribute("FeralDead") == true then
            stopMovement()
            print("ANIMAL MORTO CONFIRMADO:", npc.Name)
            recordConfirmedKill()
            return true
        end
        if waterSafety.rescuing then
            warn("AUTO HUNT: preso na agua por 10s, interrompendo para resgate")
            break
        end
        if amberMode then
            local permitted, reason = amberReady(false)
            if not permitted then
                if reason == "VIDA BAIXA" then
                    amberPauseUntil = os.clock() + CONFIG.AmberPauseAfterDangerSeconds
                    failedUntil[npc] = amberPauseUntil
                    warn("GET AMBER: perigo! Caca pausada por vida baixa")
                else
                    print("GET AMBER: pausando -", reason)
                end
                break
            end
        end
        if not root.Parent then break end
        if questTitle then
            local huntProgress = questSeen[questTitle]
            if huntProgress and huntProgress.done then
                questCompletedDuringChase = true
                print("AUTO QUEST CACA: concluida; interrompendo perseguicao", questTitle)
                break
            end
        end
        local h = getHunger()
        if not amberMode and not questTitle and h and h >= CONFIG.HungerStop then break end
        if CONFIG.AutoDrink and getThirst() and getThirst() <= CONFIG.DrinkStart then
            print("Auto Hunt: pausando para beber")
            break
        end
        -- Com Get Amber ligado, todas as cacas respeitam limite de vida mais alto.
        local hpFloor = CONFIG.GetAmber and CONFIG.AmberAbortHealthPercent
            or CONFIG.MinHealthPercent
        if hum.MaxHealth > 0
            and hum.Health / hum.MaxHealth * 100 < hpFloor then
            warn("Vida do lobo baixa. Caca interrompida.")
            break
        end
        local npcHP = npcHealth(npc)
        if npcHP ~= nil and previousNPCHealth ~= nil
            and npcHP < previousNPCHealth - 0.01 then
            verifiedHits += 1
            print("DANO NO NPC CONFIRMADO:", previousNPCHealth, "->", npcHP)
        end
        if npcHP ~= nil then previousNPCHealth = npcHP end

        if horizontal(lastPos, root.Position).Magnitude > 1 then
            lastPos = root.Position
            lastMoved = os.clock()
        end
        local navigationDistance = getDistance()
        local actualPosition = preyPosition()
        local d = horizontal(root.Position, actualPosition).Magnitude
        local heightDifference = math.abs(root.Position.Y - actualPosition.Y)
        local inAttackRange = d <= CONFIG.AttackDistance
            and heightDifference <= CONFIG.AttackVerticalTolerance
        if inAttackRange then
            faceTarget(root, actualPosition, true)
            lastMoved = os.clock()
        end
        if os.clock() - lastMoved > CONFIG.StuckTimeout then
            warn("Sem movimento ao perseguir")
            break
        end
        if os.clock() - nextLog >= 4 then
            print("Alvo:", npc.Name, "dist real:", math.floor(d * 10) / 10,
                "| altura:", math.floor(heightDifference * 10) / 10,
                "| dist navegacao:", math.floor(navigationDistance * 10) / 10,
                "| ataque manual",
                "| golpes confirmados:", verifiedHits,
                "| vida NPC:", tostring(npcHP))
            nextLog = os.clock()
        end
    end
    stopMovement()
    if controlsEpoch ~= actionEpoch or not CONFIG.AutoFood then return false end
    if questCompletedDuringChase then return true end
    if npc.Parent and npc:GetAttribute("FeralDead") == true then
        print("ANIMAL MORTO CONFIRMADO:", npc.Name)
        recordConfirmedKill()
        return true
    end
    if amberMode then
        print("GET AMBER: abate nao confirmado; mudando de alvo")
    else
        warn("Caca nao confirmada: FeralDead nao mudou para true")
    end
    failedUntil[npc] = os.clock() + 40
    return false
end

