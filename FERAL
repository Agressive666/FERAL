local function validPosition(p)
    return typeof(p) == "Vector3"
        and math.abs(p.X) < 20000
        and math.abs(p.Y) < 20000
        and math.abs(p.Z) < 20000
end

-- Gira o corpo para a direcao real do destino durante TODO o movimento.
-- O V7 so virava no momento do clique, fazendo o modelo andar de costas.
local function faceTarget(root, target, immediate)
    if not root or not root.Parent or not validPosition(target) then return end
    local flat = Vector3.new(target.X, root.Position.Y, target.Z)
    if (flat - root.Position).Magnitude < 0.1 then return end
    local desired = CFrame.lookAt(root.Position, flat)
        * CFrame.Angles(0, math.rad(CONFIG.FaceOffsetDeg), 0)
    if immediate then
        root.CFrame = desired
    else
        root.CFrame = root.CFrame:Lerp(desired, CONFIG.TurnLerp)
    end
end

-- === V8.9.34: PROTECAO CONTRA AFOGAMENTO ===
-- Nao modifica Terrain nem teleporta o personagem. O servidor ainda pode corrigir fisica.
local waterParams = RaycastParams.new()
waterParams.FilterType = Enum.RaycastFilterType.Include
waterParams.FilterDescendantsInstances = {Terrain}
waterParams.IgnoreWater = false
local safeLandPosition = nil
local safeLandCharacter = nil
local lastWaterMaterial, lastWaterSurface = nil, nil
local nextWaterSafetyCheck = 0
local safeRescueConnection = nil
local waterSafety = {rescuing=false, blocked=false, blockedAt=0, waterAt=0,
    lastSwimmingMoveAt=0, lastSwimmingPos=nil, swimGoal=nil, lastGoalDistance=nil,
    nativeAt=0, nativePos=nil, lastTeleportAt=0}
local lastWaterWarning = 0
local nextRescueScan = 0
local cachedRescueDestination = nil

local function surfaceAt(position)
    if typeof(position) ~= "Vector3" then return nil, nil end
    local result = workspace:Raycast(position + Vector3.new(0, 24, 0),
        Vector3.new(0, -82, 0), waterParams)
    return result and result.Material, result and result.Position or nil
end

local function directionOrZero(fromPos, toPos)
    local flat = horizontal(fromPos, toPos)
    return flat.Magnitude > .2 and flat.Unit or Vector3.zero
end

local function rescueFromWater(hum, root, baseSpeed, swimGoal)
    local now=os.clock()
    if safeLandCharacter ~= player.Character then
        safeLandCharacter = player.Character
        safeLandPosition = nil
        waterSafety.waterAt = 0
        waterSafety.lastSwimmingMoveAt = 0
        waterSafety.lastSwimmingPos = nil
        waterSafety.lastGoalDistance = nil
    end
    local mat,surf=surfaceAt(root.Position)
    local swimming=hum:GetState()==Enum.HumanoidStateType.Swimming
    local inWater=swimming or (mat==Enum.Material.Water and surf
        and root.Position.Y<=surf.Y+2.7)
    if not inWater then
        waterSafety.rescuing=false
        waterSafety.waterAt=0
        waterSafety.lastSwimmingMoveAt=0
        waterSafety.lastSwimmingPos=nil
        waterSafety.lastGoalDistance=nil
        waterSafety.nativeAt=0
        waterSafety.nativePos=nil
        if mat and mat~=Enum.Material.Water and surf
            and root.Position.Y>=surf.Y-2 and root.Position.Y<=surf.Y+9 then
            safeLandPosition=Vector3.new(root.Position.X,surf.Y+3,root.Position.Z)
        end
        return nil
    end
    if waterSafety.waterAt==0 then
        waterSafety.waterAt=now
        waterSafety.lastSwimmingMoveAt=now
        waterSafety.lastSwimmingPos=root.Position
        waterSafety.lastGoalDistance=nil
    end
    -- Avanco real: progresso de pelo menos 4 studs na direcao do objetivo.
    -- Balancar 3 studs para os lados NAO reseta o timeout.
    if typeof(swimGoal)=="Vector3" then
        local dist=horizontal(root.Position,swimGoal).Magnitude
        if not waterSafety.lastGoalDistance or dist<waterSafety.lastGoalDistance-4 then
            waterSafety.lastGoalDistance=dist
            waterSafety.lastSwimmingMoveAt=now
            waterSafety.lastSwimmingPos=root.Position
        end
    else
        if waterSafety.lastSwimmingPos and
            horizontal(root.Position,waterSafety.lastSwimmingPos).Magnitude>=10 then
            waterSafety.lastSwimmingPos=root.Position
            waterSafety.lastSwimmingMoveAt=now
        end
    end
    local stuckSeconds=now-waterSafety.lastSwimmingMoveAt
    if stuckSeconds < CONFIG.WaterRescueAfterStuckSeconds then
        waterSafety.rescuing=false
        return nil
    end
    waterSafety.rescuing=true
    -- Fallback de emergencia: retornar ao ultimo terreno que o sensor CONFIRMOU seco.
    -- CFrame local pode ser revertido pelo servidor; por isso verifica e registra.
    local lastLand=safeLandPosition
    local canReturn=lastLand and horizontal(root.Position,lastLand).Magnitude
        <= CONFIG.WaterRescueMaxReturnDistance
    if canReturn then
        local check,ground=surfaceAt(lastLand)
        canReturn=check and check~=Enum.Material.Water and ground~=nil
    end
    if CONFIG.WaterRescueTeleportEnabled and canReturn
        and now-waterSafety.lastTeleportAt>=3 then
        waterSafety.lastTeleportAt=now
        local before=root.Position
        local target=Vector3.new(lastLand.X,lastLand.Y+3,lastLand.Z)
        local ok=pcall(function()
            root.AssemblyLinearVelocity=Vector3.zero
            root.CFrame=CFrame.new(target, target + root.CFrame.LookVector)
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
        warn("THE GOAT AGUA: 10s SEM PROGRESSO; tentativa de retorno a terra:",
            ok, "distancia:",math.floor(horizontal(before,target).Magnitude))
        waterSafety.lastSwimmingMoveAt=now
        waterSafety.lastSwimmingPos=target
        waterSafety.lastGoalDistance=nil
        return nil
    end
    -- Se nao houver margem salva, procurar terreno seco local e nadar na direcao dele.
    local destination=canReturn and lastLand or nil
    if not destination then
        if now>=nextRescueScan then
            nextRescueScan=now+2
            cachedRescueDestination=nil
            for _,radius in ipairs({12,25,40,65,95,130}) do
                for i=0,15 do
                    local angle=i*math.pi/8
                    local sample=root.Position + Vector3.new(
                        math.cos(angle)*radius,0,math.sin(angle)*radius)
                    local groundMaterial,ground=surfaceAt(sample)
                    if groundMaterial and groundMaterial~=Enum.Material.Water and ground then
                        cachedRescueDestination=Vector3.new(sample.X,ground.Y+3,sample.Z)
                        break
                    end
                end
                if cachedRescueDestination then break end
            end
        end
        destination=cachedRescueDestination
    end
    local dir=destination and directionOrZero(root.Position,destination) or
        Vector3.new(-root.CFrame.LookVector.X,0,-root.CFrame.LookVector.Z)
    if dir.Magnitude<.1 then dir=Vector3.new(1,0,0) else dir=dir.Unit end
    if now-lastWaterWarning>4 then
        warn("THE GOAT AGUA: nadando sem progresso; tentando alcancar margem seca")
        lastWaterWarning=now
    end
    return dir,CONFIG.WaterRescueSpeed,true
end

local function safeTravelDirection(root, direction, allowWater)
    -- V8.9.10 desviava lateralmente ao ver agua e as vezes zerava o movimento,
    -- impedindo o animal de atravessar rios/lagos ate para concluir quests.
    if CONFIG.WaterAllowCrossing or allowWater or not CONFIG.WaterSafetyEnabled then
        waterSafety.blocked = false
        waterSafety.blockedAt = 0
        return direction, false
    end
    local probe = root.Position + direction * CONFIG.WaterGuardLookAhead
    local mat, waterHit = surfaceAt(probe)
    -- Agua muito abaixo de um barranco nao significa que o trajeto e um lago.
    if mat ~= Enum.Material.Water or not waterHit
        or math.abs(root.Position.Y - waterHit.Y) > 10 then
        waterSafety.blocked=false
        waterSafety.blockedAt=0
        return direction,false
    end
    if not waterSafety.blocked then
        waterSafety.blocked = true
        waterSafety.blockedAt = os.clock()
    end
    -- Caminho reto atravessaria agua; testar desvio lateral sobre terra.
    for _, ang in ipairs({math.pi/2,-math.pi/2, math.pi/3,-math.pi/3, 2*math.pi/3,-2*math.pi/3}) do
        local alternate = Vector3.new(
            direction.X*math.cos(ang)-direction.Z*math.sin(ang), 0,
            direction.X*math.sin(ang)+direction.Z*math.cos(ang))
        if surfaceAt(root.Position + alternate * CONFIG.WaterGuardLookAhead) ~= Enum.Material.Water then
            return alternate,true
        end
    end
    return Vector3.zero,true
end

