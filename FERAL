local function stopMovement()
    if movementConnection then
        movementConnection:Disconnect()
        movementConnection = nil
    end
    local wasSwimming = movementHum and movementHum.Parent
        and movementHum:GetState()==Enum.HumanoidStateType.Swimming
    if movementRoot and movementRoot.Parent and not wasSwimming then
        local v = movementRoot.AssemblyLinearVelocity
        movementRoot.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
    end
    if movementHum and movementHum.Parent then
        if not wasSwimming then movementHum:Move(Vector3.zero, false) end
        if savedWalkSpeed ~= nil then
            movementHum.WalkSpeed = savedWalkSpeed
        end
        if savedAutoRotate ~= nil then
            movementHum.AutoRotate = savedAutoRotate
        end
    end
    if savedAlign and savedAlign.Parent and savedAlignEnabled ~= nil then
        savedAlign.Enabled = savedAlignEnabled
    end
    movementHum, movementRoot, savedWalkSpeed = nil, nil, nil
    savedAutoRotate, savedAlign, savedAlignEnabled = nil, nil, nil
    waterSafety.blocked=false
    waterSafety.blockedAt=0
end

local function stop()
    if not active then return end
    active = false
    controlsEpoch += 1
    pcall(stopMovement)
    for _, connection in ipairs(feedFocusConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(feedFocusConnections)
    if safeRescueConnection then
        pcall(function() safeRescueConnection:Disconnect() end)
        safeRescueConnection = nil
    end
    if stopQuestTabHooks then
        pcall(stopQuestTabHooks)
        stopQuestTabHooks = nil
    end
    if destroyPanel then
        pcall(destroyPanel)
        destroyPanel = nil
    end
end

