    remoteAttempts=0, remoteDispatches=0, keyboardFallbacks=0}
local pressE
local function feedInteraction(kind)
    if kind ~= "eat" and kind ~= "drink" then return false, "INVALIDO" end
    if not active then return false, "INATIVO" end
    if CONFIG.FeedRemoteFirst then
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("WolfActions")
        if remote and remote:IsA("RemoteEvent") then
            feedDebug.remoteAttempts += 1
            local ok, err = pcall(function()
                remote:FireServer("Feed",kind)
            end)
            feedDebug.lastAction=kind
            feedDebug.lastAt=os.clock()
            if ok then
                feedDebug.remoteDispatches += 1
                feedDebug.lastMethod="REMOTE"
                feedDebug.lastError=nil
                return true, "REMOTE"
            end
            feedDebug.lastError=tostring(err)
            warn("THE GOAT FEED: falha no WolfActions:",tostring(err))
        else
