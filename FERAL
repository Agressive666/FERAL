local function npcHealth(npc)
    local npcHum = npc:FindFirstChildOfClass("Humanoid")
    if npcHum then return npcHum.Health end
    for _, key in ipairs({"Health", "HP", "FeralHealth"}) do
        local value = npc:GetAttribute(key)
